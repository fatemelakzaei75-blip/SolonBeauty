@page "/blog/{Slug}"
@using BlazorAppSolon.Data
@inject NavigationManager Nav
@inject DataCore.Interfaces.ISeoService Seo

<SeoHeader Model="_seo" />

@if (_post is null)
{
    <PageBurn Title="مقاله یافت نشد" />
    <section class="section light">
        <div class="container" style="text-align:center">
            <a class="btn-solon" href="blog">بازگشت به وبلاگ</a>
        </div>
    </section>
}
else
{
    <PageBurn Title="@_post.Category" />

    <article class="section light">
        <LeafDeco Position="leaf-bl" />
        <div class="container" style="max-width:820px">

            <!-- نوار راهنمای خرده‌نان برای وبلاگ -->
            <BreadcrumbNav Items="_seo.Breadcrumbs" />

            <h1 class="post-title" style="margin-top:1.5rem;">@_post.Title</h1>
            <div class="post-meta">
                <span>✍️ نویسنده: @_post.Author</span>
                <span>📅 تاریخ انتشار: @PersianDateHelper.ToShamsiLong(_post.Date)</span>
                <span>⏱ زمان مطالعه: @_post.ReadMinutes دقیقه</span>
            </div>

            <img class="post-hero" src="@_post.Image" alt="@_post.Title" width="820" height="460" loading="eager" />

            <p class="post-lead">@_post.Summary</p>

            @foreach (var sec in _post.Sections)
            {
                <h2 class="post-h2">@sec.Heading</h2>
                @foreach (var p in sec.Paragraphs)
                {
                    <p class="post-p">@p</p>
                }
                @if (sec.Bullets is not null)
                {
                    <ul class="post-list">
                        @foreach (var b in sec.Bullets) { <li>@b</li> }
                    </ul>
                }
            }

            <div class="post-tags">
                @foreach (var t in _post.Tags) { <span>#@t</span> }
            </div>

            <div class="post-cta">
                <div>
                    <h3>سؤالی درباره این موضوع دارید؟</h3>
                    <p>مشاوره رایگان بگیرید یا همین حالا نوبت خود را رزرو کنید.</p>
                </div>
                <a class="btn-solon red lg" href="reserve">رزرو نوبت</a>
            </div>

            <h3 class="section-title" style="margin-top:3rem">مطالب مرتبط</h3>
            <div class="blog-grid">
                @foreach (var rel in BlogCatalog.Related(_post))
                {
                    <a class="blog-card" href="@($"blog/{rel.Slug}")">
                        <img src="@rel.Image" alt="@rel.Title" width="380" height="240" loading="lazy" />
                        <div>
                            <span class="work-chip">@rel.Category</span>
                            <h3>@rel.Title</h3>
                            <small>@PersianDateHelper.ToShamsi(rel.Date)</small>
                        </div>
                    </a>
                }
            </div>
        </div>
    </article>
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    private BlogPost? _post;
    private SeoMetadata _seo = new();

    protected override void OnParametersSet()
    {
        _post = BlogCatalog.BySlug(Slug);
        if (_post is not null)
        {
            _seo = Seo.GetBlogPostSeo(_post.Slug, _post.Title, _post.Summary, _post.Author, _post.Date, _post.Image, Nav.BaseUri);
        }
        else
        {
            _seo = Seo.GetNoIndexSeo("مقاله یافت نشد");
        }
    }
}
