@page "/gallery"
@using BlazorAppSolon.Data
@inject NavigationManager Nav
@inject DataCore.Interfaces.ISeoService Seo

<SeoHeader Model="_seo" />

@* بند ۱۰ : گالری نمونه کارها و فضای سالن *@
<PageBurn Title="نمونه کارها و تصاویر سالن" />

<section class="section light">
    <LeafDeco Position="leaf-bl" />
    <div class="container">
        <BreadcrumbNav Items="_seo.Breadcrumbs" />

        <div class="filter-bar" style="margin-top:1.5rem;">
            <button class="chip @(_filter == "" ? "on" : "")" @onclick='() => _filter = ""'>همه</button>
            @foreach (var s in PortfolioCatalog.Services)
            {
                <button class="chip @(_filter == s.Slug ? "on" : "")" @onclick="() => _filter = s.Slug">@s.Title</button>
            }
        </div>

        <div class="work-grid">
            @foreach (var item in Items)
            {
                <PortfolioCard Item="item" OnOpen="i => _selected = i" />
            }
        </div>

        <h3 class="section-title" style="margin-top:3.2rem">فضای داخلی سالن</h3>
        <div class="photo-grid">
            <img src="img/hero.jpg" alt="فضای داخلی سالن حدیث" loading="lazy" />
            <img src="img/cta.jpg" alt="فضای داخلی سالن حدیث" loading="lazy" />
            <img src="img/gallery-2.jpg" alt="فضای داخلی سالن حدیث" loading="lazy" />
        </div>
    </div>
</section>

<PortfolioDetail Item="_selected" OnClose="() => _selected = null" />

@code {
    private string _filter = "";
    private PortfolioItem? _selected;
    private SeoMetadata _seo = new();

    protected override void OnInitialized()
    {
        _seo = Seo.GetGeneralPageSeo(
            "گالری نمونه کارها و تصاویر سالن زیبایی حدیث",
            "مشاهده آلبوم تصاویر قبل و بعد، نمونه‌کارهای لاین‌های تخصصی ناخن، مو، میکاپ عروس، فیشال و فضای شیک سالن زیبایی حدیث.",
            "gallery",
            Nav.BaseUri);
    }

    private List<PortfolioItem> Items
        => string.IsNullOrEmpty(_filter) ? PortfolioCatalog.All() : PortfolioCatalog.ByService(_filter);
}
