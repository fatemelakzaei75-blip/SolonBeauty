@page "/login"
@layout BlazorAppSolon.Layout.AuthLayout
@using BlazorAppSolon.Auth
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthService Auth
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState

@* ==========================================================================
   صفحه ورود — مرحله ۶
   --------------------------------------------------------------------------
   این صفحه «مغز» فرم است: اعتبارسنجی فارسی، حالت بارگذاری و فراخوانی API
   همه اینجا هستند و کارت (LoginCard) فقط نمایش می‌دهد. چرا: اگر کارت هم
   خودش API صدا بزند، دو مسیر موازی برای یک کار پیدا می‌شود و دیر یا زود
   یکی از آن دو از قلم می‌افتد (مثلاً حالت بارگذاری یا پاک‌کردن خطاها).

   جریان:
     رمز عبور → «ورود»                    → Auth.LoginWithPasswordAsync
     رمز عبور → «ورود با کد یکبار مصرف»   → اعتبارسنجی شماره → SendCodeAsync
     کد یکبار مصرف → «تأیید و ورود»        → Auth.LoginAsync
     «رمز عبور را فراموش کرده‌اید؟»        → برگ بازیابی (ResetPasswordAsync)
   پس از موفقیت: اگر returnUrl معتبر باشد همان، وگرنه پنل نقش کاربر.

   چرا returnUrl: RedirectToLogin کاربر را با returnUrl به اینجا می‌فرستد؛
   اگر نادیده گرفته شود، کاربر بعد از ورود به پنل می‌رود و صفحه‌ای که می‌خواست
   گم می‌شود. فقط مسیرهای داخلی پذیرفته می‌شوند (نه آدرس کامل) تا کسی نتواند
   با لینک دستکاری‌شده کاربر را به سایت دیگری بفرستد.
   ========================================================================== *@

<PageTitle>ورود به حساب | سالن زیبایی حدیث</PageTitle>

<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<div class="lg">
    <div class="lg-shell">

        <LoginCard Step="@_step"
                   @bind-Mobile="_mobile"
                   @bind-Password="_password"
                   @bind-Code="_code"
                   MobileError="@_mobileError"
                   PasswordError="@_passwordError"
                   CodeError="@_codeError"
                   Message="@_message"
                   MessageKind="@_messageKind"
                   Loading="@_busy"
                   SendingCode="@_sending"
                   OnSubmit="SubmitAsync"
                   OnOtp="StartOtpAsync"
                   OnResend="SendCodeAsync"
                   OnBackToPassword="BackToPassword"
                   OnForgotPassword="OpenForgotAsync" />

        <p class="lg-shell__foot">© سالن زیبایی حدیث — همه حقوق محفوظ است.</p>

        @if (ShowDevTools)
        {
            @* فقط در بیلد توسعه. چرا: بررسی سه نقش پنل باید سریع باشد و
               تایپ کردن شماره و کد هر بار وقت می‌گیرد؛ در نسخه انتشار
               این بلوک اصلاً کامپایل نمی‌شود. *@
            <div class="lg-dev">
                <span class="lg-dev__label">حساب‌های آزمایشی (فقط بیلد توسعه)</span>
                <button type="button" class="lg-dev__chip" disabled="@_busy"
                        @onclick="@(() => QuickLoginAsync("09120000003"))">مشتری</button>
                <button type="button" class="lg-dev__chip" disabled="@_busy"
                        @onclick="@(() => QuickLoginAsync("09120000002"))">پرسنل</button>
                <button type="button" class="lg-dev__chip" disabled="@_busy"
                        @onclick="@(() => QuickLoginAsync("09120000001"))">مدیر سالن</button>
            </div>
        }
    </div>

    @* برگ بازیابی رمز: در موبایل برگ پایین، در دسکتاپ پنجره میانی *@
    <ForgotPasswordSheet @ref="_sheet"
                         Visible="@_sheetOpen"
                         @bind-Mobile="_resetMobile"
                         @bind-Code="_resetCode"
                         @bind-NewPassword="_resetPassword"
                         MobileError="@_resetMobileError"
                         CodeError="@_resetCodeError"
                         PasswordError="@_resetPasswordError"
                         Message="@_resetMessage"
                         MessageKind="@_resetMessageKind"
                         Loading="@_busy"
                         OnSubmit="SubmitResetAsync"
                         OnClose="CloseForgot" />
</div>

@code {
    private string _step = "password";          // password | otp

    private string _mobile = "";
    private string _password = "";
    private string _code = "";

    private string? _mobileError;
    private string? _passwordError;
    private string? _codeError;

    private string? _message;
    private string _messageKind = "error";

    private bool _busy;                         // ورود یا ذخیره در جریان است
    private bool _sending;                      // ارسال کد پیامکی در جریان است

    // ---------- برگ بازیابی رمز ----------
    private bool _sheetOpen;
    private ForgotPasswordSheet? _sheet;
    private string _resetMobile = "";
    private string _resetCode = "";
    private string _resetPassword = "";
    private string? _resetMobileError;
    private string? _resetCodeError;
    private string? _resetPasswordError;
    private string? _resetMessage;
    private string _resetMessageKind = "error";

    /// <summary>پارامتر آدرس: صفحه‌ای که کاربر می‌خواست باز کند.</summary>
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

#if DEBUG
    private const bool ShowDevTools = true;
#else
    private const bool ShowDevTools = false;
#endif

    protected override async Task OnInitializedAsync()
    {
        // کاربر وارد‌شده که صفحه ورود را باز کند، نباید فرم ببیند.
        var state = await AuthState.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
            Nav.NavigateTo(ResolveTarget(RoleOf(state.User)));
    }

    // ==================== اعتبارسنجی فارسی ====================
    // پیام‌ها کوتاه و راهنما هستند: می‌گویند چه چیزی درست نیست و شکل درست
    // چیست. هر پیام زیر همان فیلد می‌آید (role=alert در CapsuleField).

    private static string? ValidateMobile(string? value)
    {
        var mobile = DigitHelper.Normalize(value);
        if (string.IsNullOrEmpty(mobile))
            return "شماره موبایل را وارد کنید.";
        if (!Regex.IsMatch(mobile, @"^09\d{9}$"))
            return "شماره موبایل باید ۱۱ رقم و با ۰۹ شروع شود.";
        return null;
    }

    private static string? ValidatePassword(string? value)
    {
        if (string.IsNullOrEmpty(value))
            return "رمز عبور را وارد کنید.";
        if (value.Length < 6)
            return "رمز عبور باید حداقل ۶ کاراکتر باشد.";
        return null;
    }

    private static string? ValidateCode(string? value)
    {
        var code = DigitHelper.Normalize(value);
        if (string.IsNullOrEmpty(code))
            return "کد تأیید را وارد کنید.";
        if (!Regex.IsMatch(code, @"^\d{5}$"))
            return "کد تأیید ۵ رقمی است.";
        return null;
    }

    // ==================== گام رمز عبور ====================

    /// <summary>دکمه اصلی فرم؛ گام تعیین می‌کند کدام کار انجام شود.</summary>
    private async Task SubmitAsync()
    {
        if (_busy) return;

        if (_step == "otp") { await SubmitOtpAsync(); return; }
        await SubmitPasswordAsync();
    }

    private async Task SubmitPasswordAsync()
    {
        _message = null;
        _mobileError = ValidateMobile(_mobile);
        _passwordError = ValidatePassword(_password);
        if (_mobileError is not null || _passwordError is not null) return;

        _busy = true;
        var (ok, msg, user) = await Auth.LoginWithPasswordAsync(
            DigitHelper.Normalize(_mobile), _password);
        _busy = false;

        if (ok && user is not null)
        {
            Nav.NavigateTo(ResolveTarget(user.Roles.FirstOrDefault() ?? AppRoles.Customer));
            return;
        }

        _messageKind = "error";
        _message = msg;
    }

    // ==================== گام کد یکبار مصرف ====================

    /// <summary>
    /// رفتن به گام کد. اول شماره اعتبارسنجی می‌شود: اگر شماره نادرست باشد،
    /// فرستادن کد بی‌معنا است و کاربر باید همان‌جا خطا را ببیند.
    /// </summary>
    private async Task StartOtpAsync()
    {
        _message = null;
        _mobileError = ValidateMobile(_mobile);
        if (_mobileError is not null) return;

        _mobile = DigitHelper.Normalize(_mobile);
        _code = "";
        _codeError = null;
        _step = "otp";
        _passwordError = null;

        await SendCodeAsync();
    }

    private async Task SendCodeAsync()
    {
        if (_sending) return;

        _mobileError = ValidateMobile(_mobile);
        if (_mobileError is not null) return;

        _sending = true;
        var (ok, msg) = await Auth.SendCodeAsync(_mobile);
        _sending = false;

        _messageKind = ok ? "ok" : "error";
        _message = msg;
    }

    private async Task SubmitOtpAsync()
    {
        _message = null;
        _mobileError = ValidateMobile(_mobile);
        _codeError = ValidateCode(_code);
        if (_mobileError is not null || _codeError is not null) return;

        _busy = true;
        var (ok, msg, user) = await Auth.LoginAsync(new LoginRequest
        {
            MobileNumber = DigitHelper.Normalize(_mobile),
            Code = DigitHelper.Normalize(_code)
        });
        _busy = false;

        if (ok && user is not null)
        {
            Nav.NavigateTo(ResolveTarget(user.Roles.FirstOrDefault() ?? AppRoles.Customer));
            return;
        }

        _messageKind = "error";
        _message = msg;
    }

    private void BackToPassword()
    {
        _step = "password";
        _code = "";
        _codeError = null;
        _message = null;
    }

    // ==================== بازیابی رمز عبور ====================

    private async Task OpenForgotAsync()
    {
        _sheetOpen = true;
        _resetMessage = null;
        _resetMobileError = _resetCodeError = _resetPasswordError = null;

        // شماره‌ای که کاربر در فرم وارد کرده، همراه می‌آید تا دوباره تایپ نکند.
        _resetMobile = DigitHelper.Normalize(_mobile);

        await InvokeAsync(async () =>
        {
            await Task.Yield();                       // صبر تا برگه رندر شود
            if (_sheet is not null) await _sheet.FocusFirstFieldAsync();
        });
    }

    private void CloseForgot()
    {
        _sheetOpen = false;
        _resetMessage = null;
        _resetMobileError = _resetCodeError = _resetPasswordError = null;
    }

    private async Task SubmitResetAsync()
    {
        if (_busy) return;

        _resetMessage = null;
        _resetMobileError = ValidateMobile(_resetMobile);
        _resetCodeError = ValidateCode(_resetCode);
        _resetPasswordError = ValidatePassword(_resetPassword);
        if (_resetMobileError is not null || _resetCodeError is not null
            || _resetPasswordError is not null) return;

        _busy = true;
        var (ok, msg) = await Auth.ResetPasswordAsync(
            DigitHelper.Normalize(_resetMobile),
            DigitHelper.Normalize(_resetCode),
            _resetPassword);
        _busy = false;

        _resetMessageKind = ok ? "ok" : "error";
        _resetMessage = msg;

        if (!ok) return;

        // موفق: برگه بسته می‌شود و کاربر با شماره پر‌شده به گام رمز برمی‌گردد.
        _step = "password";
        _mobile = _resetMobile;
        _password = "";
        _mobileError = null;
        _passwordError = null;
        _messageKind = "ok";
        _message = msg;
        _sheetOpen = false;
    }

    // ==================== ورود سریع محیط توسعه ====================

    private async Task QuickLoginAsync(string mobile)
    {
        _mobile = mobile;
        _code = AuthService.DevCode;
        _step = "otp";
        _mobileError = _codeError = null;
        await SubmitOtpAsync();
    }

    // ==================== مقصد پس از ورود ====================

    private static string RoleOf(System.Security.Claims.ClaimsPrincipal user)
        => user.Claims.FirstOrDefault(c => c.Type.Contains("role"))?.Value ?? AppRoles.Customer;

    /// <summary>
    /// اگر returnUrl یک مسیر داخلی باشد همان را برمی‌گرداند، وگرنه پنل نقش.
    /// مسیرهای بیرونی رد می‌شوند تا لینک دستکاری‌شده کاربر را جای دیگری نفرستد.
    /// </summary>
    private string ResolveTarget(string role)
    {
        var panel = AppRoles.PanelUrl(role);
        if (string.IsNullOrWhiteSpace(ReturnUrl)) return panel;

        var url = ReturnUrl.Trim();
        var looksLocal = (url.StartsWith("/") && !url.StartsWith("//") && !url.StartsWith("/\\"))
                         && !url.Contains("://");
        if (!looksLocal) return panel;
        if (url.StartsWith("/login", StringComparison.OrdinalIgnoreCase)) return panel;

        return url;
    }
}
