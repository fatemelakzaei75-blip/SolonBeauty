@page "/panel/admin"
@layout BlazorAppSolon.Layout.PanelLayout
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Authorization
@using DataLayer.Entity
@using BlazorAppSolon.Data
@using DataCore.Helpers
@inject IDataStore Store
@inject ReservationClient Reservations
@inject IJSRuntime JS

<PageTitle>داشبورد مدیریت سالن | Hadis Beauty</PageTitle>

<div class="admin-dashboard-container">
    <div class="admin-dash-header">
        <div>
            <h2 class="panel-title">داشبورد جامع مدیریت سالن حدیث</h2>
            <p class="panel-subtitle">آمار زنده، عملکرد دوره‌ای، نوبت‌های حضوری و تنظیمات سیستم</p>
        </div>
        <div class="dash-quick-actions">
            <button class="btn-solon red sm" @onclick="@(() => _showInPersonModal = true)">+ ثبت رزرو حضوری / تلفنی</button>
            <a class="btn-solon ghost sm" href="panel/admin/base-data">🗂 مدیریت اطلاعات پایه</a>
        </div>
    </div>

    @* ==================== بند ۱۸ : شاخص‌های کلیدی عملکرد (KPI) ==================== *@
    <div class="kpi-grid">
        <div class="kpi-card gold">
            <div class="kpi-icon">💰</div>
            <div class="kpi-info">
                <span class="kpi-title">مجموع درآمد ثبت‌شده</span>
                <strong class="kpi-val">@_totalRevenue.ToString("#,0") <small>تومان</small></strong>
                <span class="kpi-sub">صافی پس از استردادها: @_netRevenue.ToString("#,0") تومان</span>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon">🗓️</div>
            <div class="kpi-info">
                <span class="kpi-title">رزروهای امروز</span>
                <strong class="kpi-val">@_todayCount <small>نوبت</small></strong>
                <span class="kpi-sub">@PersianDateHelper.ToShamsi(DateTime.Today)</span>
            </div>
        </div>

        <div class="kpi-card warning">
            <div class="kpi-icon">⏳</div>
            <div class="kpi-info">
                <span class="kpi-title">در انتظار تأیید / پرداخت</span>
                <strong class="kpi-val">@_pendingCount <small>نوبت</small></strong>
                <span class="kpi-sub">نیاز به پیگیری</span>
            </div>
        </div>

        <div class="kpi-card success">
            <div class="kpi-icon">✓</div>
            <div class="kpi-info">
                <span class="kpi-title">نوبت‌های تکمیل‌شده</span>
                <strong class="kpi-val">@_completedCount <small>نوبت</small></strong>
                <span class="kpi-sub">انجام‌شده یا تأیید قطعی</span>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon">👥</div>
            <div class="kpi-info">
                <span class="kpi-title">کل مشتریان سالن</span>
                <strong class="kpi-val">@_customerCount <small>نفر</small></strong>
                <span class="kpi-sub">باشگاه مشتریان</span>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon">👩‍🎨</div>
            <div class="kpi-info">
                <span class="kpi-title">پرسنل فعال سالن</span>
                <strong class="kpi-val">@_personnelCount <small>متخصص</small></strong>
                <span class="kpi-sub">در کلیه لاین‌ها</span>
            </div>
        </div>
    </div>

    @* ==================== بند ۲۳ و ۲۲ : تنظیم تم نرم‌افزار و ساعت کاری ==================== *@
    <div class="panel-card" style="margin-top:1.5rem">
        <div class="panel-card-head">
            <h3>تنظیمات تم و ساعات کاری سالن</h3>
        </div>
        <div class="settings-strip-grid">
            <!-- انتخاب تم نرم‌افزار (بند ۲۳ سند) -->
            <div class="setting-item-block">
                <label><strong>قالب و تم بصری فعال:</strong></label>
                <div class="theme-buttons-group">
                    <button class="theme-chip @(_activeTheme == "luxury" ? "active" : "")" @onclick="@(() => SetTheme("luxury"))">✨ لوکس (طلایی حدیث)</button>
                    <button class="theme-chip @(_activeTheme == "classic" ? "active" : "")" @onclick="@(() => SetTheme("classic"))">🏛 کلاسیک</button>
                    <button class="theme-chip @(_activeTheme == "modern" ? "active" : "")" @onclick="@(() => SetTheme("modern"))">🎨 مدرن</button>
                    <button class="theme-chip @(_activeTheme == "minimal" ? "active" : "")" @onclick="@(() => SetTheme("minimal"))">⚪ مینیمال</button>
                    <button class="theme-chip @(_activeTheme == "dark" ? "active" : "")" @onclick="@(() => SetTheme("dark"))">🌙 تیره (Dark)</button>
                </div>
            </div>

            <!-- ساختار سالن: تک لاین یا چند لاین (بند ۲ و ۳ سند) -->
            <div class="setting-item-block">
                <label><strong>ساختار سالن:</strong></label>
                <div class="theme-buttons-group">
                    <button class="theme-chip @(!_isSingleLineMode ? "active" : "")" @onclick="@(() => SetSalonStructure(false))">🏢 چندلاینه (همه خدمات)</button>
                    <button class="theme-chip @(_isSingleLineMode ? "active" : "")" @onclick="@(() => SetSalonStructure(true))">💅 تک‌لاینه (فقط نمونه کار)</button>
                </div>
            </div>

            <!-- ساعات کاری فعالیت نرم‌افزار (بند ۲۲ سند) -->
            <div class="setting-item-block">
                <label><strong>ساعات فعالیت سالن (بند ۲۲):</strong></label>
                <div style="display:flex;gap:.5rem;align-items:center;margin-top:.4rem">
                    <span>از:</span>
                    <input type="time" class="panel-input" style="width:110px" @bind="_openingTime" />
                    <span>تا:</span>
                    <input type="time" class="panel-input" style="width:110px" @bind="_closingTime" />
                    <button class="btn-solon sm" @onclick="SaveHours">ذخیره ساعات</button>
                </div>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(_settingsMsg))
        {
            <div class="panel-alert ok" style="margin-top:1rem">@_settingsMsg</div>
        }
    </div>

    @* ==================== بند ۱۸ : گزارش‌های دوره‌ای و عملکرد ==================== *@
    <div class="panel-card" style="margin-top:1.5rem">
        <div class="panel-card-head">
            <h3>گزارش‌های دوره‌ای عملکرد سالن (بند ۱۸ سند)</h3>
            <div class="period-tabs">
                <button class="period-btn @(_period == "daily" ? "active" : "")" @onclick="@(() => SetPeriod("daily"))">روزانه</button>
                <button class="period-btn @(_period == "weekly" ? "active" : "")" @onclick="@(() => SetPeriod("weekly"))">هفتگی</button>
                <button class="period-btn @(_period == "monthly" ? "active" : "")" @onclick="@(() => SetPeriod("monthly"))">ماهانه</button>
                <button class="period-btn @(_period == "yearly" ? "active" : "")" @onclick="@(() => SetPeriod("yearly"))">سالانه</button>
            </div>
        </div>

        <div class="report-content-grid">
            <div class="report-table-box">
                <h4>محبوب‌ترین خدمات در بازه @_periodLabel</h4>
                <table class="panel-table">
                    <thead>
                        <tr>
                            <th>خدمت</th>
                            <th>تعداد رزرو</th>
                            <th>مجموع درآمد</th>
                            <th>درصد محبوبیت</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td>کاشت و طراحی ناخن</td><td>۲۸</td><td>۵۳,۲۰۰,۰۰۰ تومان</td><td>۳۸٪</td></tr>
                        <tr><td>رنگ و بالیاژ مو</td><td>۱۹</td><td>۶۱,۵۰۰,۰۰۰ تومان</td><td>۲۶٪</td></tr>
                        <tr><td>میکاپ و شنیون عروس</td><td>۸</td><td>۵۸,۰۰۰,۰۰۰ تومان</td><td>۱۵٪</td></tr>
                        <tr><td>فیشال و پاکسازی پوست</td><td>۱۵</td><td>۲۱,۰۰۰,۰۰۰ تومان</td><td>۱۴٪</td></tr>
                        <tr><td>اکستنشن مژه</td><td>۱۱</td><td>۱۳,۲۰۰,۰۰۰ تومان</td><td>۷٪</td></tr>
                    </tbody>
                </table>
            </div>

            <div class="report-table-box">
                <h4>عملکرد پرسنل متخصص سالن</h4>
                <table class="panel-table">
                    <thead>
                        <tr>
                            <th>پرسنل</th>
                            <th>تخصص</th>
                            <th>نوبت‌های ثبت‌شده</th>
                            <th>رضایت</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var staff in _staffList.Take(4))
                        {
                            <tr>
                                <td><strong>@staff.FullName</strong></td>
                                <td>@staff.Specialty</td>
                                <td>@(staff.Line == "ناخن" ? "۲۸" : staff.Line == "مو" ? "۱۹" : "۱۲") نوبت</td>
                                <td>⭐ ۵.۰</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* ==================== بند ۸، ۱۰، ۱۴، ۱۵ و ۲۰ : لیست نوبت‌ها و استرداد وجه ==================== *@
    <div class="panel-card" style="margin-top:1.5rem">
        <div class="panel-card-head">
            <h3>مدیریت و پیگیری نوبت‌های سالن</h3>
            <div style="display:flex;gap:.5rem">
                <input class="panel-input" placeholder="جستجو بر اساس نام یا کد پیگیری..." @bind="_rsvSearch" @bind:event="oninput" style="width:240px" />
                <button class="btn-solon red sm" @onclick="@(() => _showInPersonModal = true)">+ ثبت رزرو حضوری</button>
            </div>
        </div>

        <div style="overflow-x:auto">
            <table class="panel-table">
                <thead>
                    <tr>
                        <th>کد پیگیری</th>
                        <th>نام مشتری</th>
                        <th>خدمت</th>
                        <th>پرسنل</th>
                        <th>تاریخ (شمسی)</th>
                        <th>ساعت</th>
                        <th>مبلغ نهایی</th>
                        <th>نوع رزرو</th>
                        <th>وضعیت نوبت</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rsv in FilteredReservations())
                    {
                        <tr>
                            <td><code>@rsv.TrackingCode</code></td>
                            <td><strong>@rsv.CustomerName</strong></td>
                            <td>@rsv.ServiceName</td>
                            <td>@(string.IsNullOrWhiteSpace(rsv.PersonalName) ? "-" : rsv.PersonalName)</td>
                            <td>@PersianDateHelper.ToShamsi(rsv.ReserveDate)</td>
                            <td>@rsv.ReserveTime.ToString(@"hh\:mm")</td>
                            <td>@((rsv.PayableAmount > 0 ? rsv.PayableAmount : rsv.Price).ToString("#,0")) تومان</td>
                            <td>
                                <span class="badge @(rsv.ReservationType == ReservationType.InPerson ? "inp" : "onl")">
                                    @(rsv.ReservationType == ReservationType.InPerson ? "حضوری" : "آنلاین")
                                </span>
                            </td>
                            <td>
                                <span class="badge @ReservationClient.StatusCss(rsv.Status)">
                                    @ReservationClient.StatusLabel(rsv.Status)
                                </span>
                                @if (rsv.RefundAmount > 0)
                                {
                                    <small class="refund-badge">استرداد: @rsv.RefundAmount.ToString("#,0")</small>
                                }
                            </td>
                            <td class="row-actions">
                                @if (rsv.Status != ReservationStatus.Confirmed && rsv.Status != ReservationStatus.Done)
                                {
                                    <button class="mini ok" @onclick="@(() => ConfirmRsv(rsv.Tc))">تأیید</button>
                                }
                                @if (rsv.Status != ReservationStatus.Canceled)
                                {
                                    <button class="mini danger" @onclick="@(() => OpenRefundModal(rsv))">لغو / استرداد</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* ==================== مودال ثبت رزرو حضوری (بند ۱۴ سند نیازمندی‌ها) ==================== *@
@if (_showInPersonModal)
{
    <div class="search-overlay" @onclick="@(() => _showInPersonModal = false)">
        <div class="search-modal" @onclick:stopPropagation style="max-width:680px">
            <div class="staff-modal-header">
                <h3>ثبت نوبت حضوری یا تلفنی (بند ۱۴ سند)</h3>
                <button class="search-close-btn" @onclick="@(() => _showInPersonModal = false)">✕</button>
            </div>
            <div class="staff-modal-body">
                <div class="form-grid">
                    <div class="form-field">
                        <label>نام مشتری <span class="req">*</span></label>
                        <input class="panel-input" @bind="_inpCustomer" placeholder="نام مراجع" />
                    </div>
                    <div class="form-field">
                        <label>شماره تماس <span class="req">*</span></label>
                        <input class="panel-input" dir="ltr" @bind="_inpMobile" placeholder="09xxxxxxxxx" />
                    </div>
                    <div class="form-field">
                        <label>انتخاب خدمت سالن <span class="req">*</span></label>
                        <select class="panel-input" @bind="_inpService">
                            @foreach (var s in PortfolioCatalog.Services)
                            {
                                <option value="@s.Title">@s.Title</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label>پرسنل مجری <span class="req">*</span></label>
                        <select class="panel-input" @bind="_inpPersonal">
                            @foreach (var st in _staffList)
                            {
                                <option value="@st.FullName">@st.FullName (@st.Line)</option>
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label>تاریخ نوبت (شمسی)</label>
                        <PersianDatePicker @bind-Value="_inpDate" />
                    </div>
                    <div class="form-field">
                        <label>ساعت نوبت</label>
                        <input type="time" class="panel-input" @bind="_inpTime" />
                    </div>
                    <div class="form-field">
                        <label>مبلغ خدمت (تومان)</label>
                        <input type="number" class="panel-input" @bind="_inpPrice" />
                    </div>
                    <div class="form-field">
                        <label>روش پرداخت (بند ۱۴)</label>
                        <select class="panel-input" @bind="_inpMethod">
                            <option value="@PaymentMethod.CardReader">دستگاه کارت‌خوان سالن (POS)</option>
                            <option value="@PaymentMethod.Cash">پرداخت نقدی در سالن</option>
                            <option value="@PaymentMethod.CardToCard">کارت به کارت</option>
                            <option value="@PaymentMethod.OnlineGateway">درگاه آنلاین</option>
                        </select>
                    </div>
                    <div class="form-field" style="grid-column:1/-1">
                        <label>توضیحات و یادداشت سالن:</label>
                        <input class="panel-input" @bind="_inpNote" placeholder="یادداشت منشی یا ادمین سالن..." />
                    </div>
                </div>

                <div class="staff-modal-footer" style="margin-top:1.5rem">
                    <button class="btn-solon red lg" @onclick="SubmitInPersonBooking" disabled="@_busy">
                        ثبت قطعی رزرو حضوری
                    </button>
                    <button class="btn-solon ghost" @onclick="@(() => _showInPersonModal = false)">انصراف</button>
                </div>
            </div>
        </div>
    </div>
}

@* ==================== مودال لغو رزرو با استرداد وجه (بند ۱۵ سند نیازمندی‌ها) ==================== *@
@if (_selectedRsvForRefund is not null)
{
    <div class="search-overlay" @onclick="@(() => _selectedRsvForRefund = null)">
        <div class="search-modal" @onclick:stopPropagation style="max-width:540px">
            <div class="staff-modal-header">
                <h3>لغو نوبت و فرآیند بازپرداخت مالی (Refund)</h3>
                <button class="search-close-btn" @onclick="@(() => _selectedRsvForRefund = null)">✕</button>
            </div>
            <div class="staff-modal-body">
                <div class="refund-info-box">
                    <div>کد پیگیری: <strong>@_selectedRsvForRefund.TrackingCode</strong></div>
                    <div>مشتری: <strong>@_selectedRsvForRefund.CustomerName</strong></div>
                    <div>مبلغ پرداخت‌شده: <strong>@_selectedRsvForRefund.PaidAmount.ToString("#,0") تومان</strong></div>
                </div>

                <div class="form-grid" style="margin-top:1rem">
                    <div class="form-field" style="grid-column:1/-1">
                        <label>مبلغ استرداد به مشتری (تومان) <span class="req">*</span></label>
                        <input type="number" class="panel-input" @bind="_refundAmount" />
                        <div class="field-hint">در صورت کسر جریمه لغو، مبلغ خالص بازگشتی را درج فرمایید.</div>
                    </div>
                    <div class="form-field" style="grid-column:1/-1">
                        <label>شماره پیگیری / مرجع بانکی استرداد (RefundReference)</label>
                        <input class="panel-input" @bind="_refundRef" placeholder="مثال: REFUND-14030701-098" />
                    </div>
                    <div class="form-field" style="grid-column:1/-1">
                        <label>دلیل لغو نوبت</label>
                        <input class="panel-input" @bind="_refundReason" placeholder="درخواست مراجع / تداخل برنامه / ..." />
                    </div>
                </div>

                <div class="staff-modal-footer" style="margin-top:1.5rem">
                    <button class="btn-solon red" @onclick="SubmitRefund" disabled="@_busy">
                        تأیید لغو و ثبت سند استرداد
                    </button>
                    <button class="btn-solon ghost" @onclick="@(() => _selectedRsvForRefund = null)">انصراف</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // KPI Data (بند ۱۸)
    private decimal _totalRevenue = 0;
    private decimal _netRevenue = 0;
    private int _todayCount = 0;
    private int _pendingCount = 0;
    private int _completedCount = 0;
    private int _customerCount = 0;
    private int _personnelCount = 0;

    // تم و ساعات (بند ۲۲ و ۲۳)
    private string _activeTheme = "luxury";
    private bool _isSingleLineMode = false;
    private DateTime _openingTime = DateTime.Today.AddHours(8);
    private DateTime _closingTime = DateTime.Today.AddHours(22);
    private string? _settingsMsg;

    // گزارش دوره‌ای (بند ۱۸)
    private string _period = "monthly";
    private string _periodLabel = "ماهانه";

    // نوبت‌ها
    private List<Tbl_Reservation> _reservations = new();
    private List<Tbl_Personal> _staffList = new();
    private string _rsvSearch = "";
    private bool _busy = false;

    // رزرو حضوری (بند ۱۴)
    private bool _showInPersonModal = false;
    private string _inpCustomer = "";
    private string _inpMobile = "";
    private string _inpService = "کاشت ناخن";
    private string _inpPersonal = "سارا محمدی";
    private DateTime _inpDate = DateTime.Today.AddDays(1);
    private DateTime _inpTime = DateTime.Today.AddHours(14);
    private decimal _inpPrice = 1_900_000;
    private PaymentMethod _inpMethod = PaymentMethod.CardReader;
    private string _inpNote = "";

    // استرداد (بند ۱۵)
    private Tbl_Reservation? _selectedRsvForRefund;
    private decimal _refundAmount = 0;
    private string _refundRef = "";
    private string _refundReason = "درخواست کنسلی توسط مراجع";

    protected override async Task OnInitializedAsync() => await LoadDashboardData();

    private async Task LoadDashboardData()
    {
        try
        {
            _reservations = await Store.AllAsync<Tbl_Reservation>();
            _staffList = await Store.AllAsync<Tbl_Personal>();
            _customerCount = await Store.CountAsync<Tbl_Customer>();
            _personnelCount = _staffList.Count(s => s.IsActive && s.IsApproved);

            var today = DateTime.Today;
            _todayCount = _reservations.Count(r => r.ReserveDate.Date == today);
            _pendingCount = _reservations.Count(r => r.Status == ReservationStatus.PendingPayment);
            _completedCount = _reservations.Count(r => r.Status == ReservationStatus.Confirmed || r.Status == ReservationStatus.PaymentSuccessful || r.Status == ReservationStatus.Done);

            _totalRevenue = _reservations.Where(r => r.PaymentStatus == PaymentStatus.Paid).Sum(r => r.PaidAmount > 0 ? r.PaidAmount : r.PayableAmount);
            var totalRefunds = _reservations.Sum(r => r.RefundAmount);
            _netRevenue = Math.Max(0, _totalRevenue - totalRefunds);

            var settingsList = await Store.AllAsync<Tbl_SalonSetting>();
            var s = settingsList.FirstOrDefault();
            if (s is not null)
            {
                _activeTheme = s.Theme;
                _isSingleLineMode = s.IsSingleLineMode;
                _openingTime = DateTime.Today.Add(s.OpeningHour);
                _closingTime = DateTime.Today.Add(s.ClosingHour);
            }
        }
        catch { }
    }

    private IEnumerable<Tbl_Reservation> FilteredReservations()
    {
        if (string.IsNullOrWhiteSpace(_rsvSearch)) return _reservations.OrderByDescending(r => r.ReserveDate);
        var q = _rsvSearch.Trim();
        return _reservations.Where(r =>
            r.CustomerName.Contains(q, StringComparison.OrdinalIgnoreCase) ||
            r.TrackingCode.Contains(q, StringComparison.OrdinalIgnoreCase) ||
            r.ServiceName.Contains(q, StringComparison.OrdinalIgnoreCase)
        ).OrderByDescending(r => r.ReserveDate);
    }

    private async Task SetTheme(string theme)
    {
        _activeTheme = theme;
        var s = (await Store.AllAsync<Tbl_SalonSetting>()).FirstOrDefault();
        if (s is not null)
        {
            s.Theme = theme;
            await Store.UpdateAsync(s);
        }
        // اعمال کلاس تم روی بدنه صفحه (بند ۲۳)
        await JS.InvokeVoidAsync("document.documentElement.setAttribute", "data-theme", theme);
        _settingsMsg = $"قالب «{theme}» با موفقیت فعال و ذخیره شد.";
    }

    private async Task SetSalonStructure(bool singleLine)
    {
        _isSingleLineMode = singleLine;
        var s = (await Store.AllAsync<Tbl_SalonSetting>()).FirstOrDefault();
        if (s is not null)
        {
            s.IsSingleLineMode = singleLine;
            await Store.UpdateAsync(s);
        }
        _settingsMsg = singleLine ? "ساختار سالن به «تک‌لاینه» تغییر یافت." : "ساختار سالن به «چندلاینه» تغییر یافت.";
    }

    private async Task SaveHours()
    {
        var s = (await Store.AllAsync<Tbl_SalonSetting>()).FirstOrDefault();
        if (s is not null)
        {
            s.OpeningHour = _openingTime.TimeOfDay;
            s.ClosingHour = _closingTime.TimeOfDay;
            await Store.UpdateAsync(s);
        }
        _settingsMsg = "ساعات فعالیت با موفقیت به‌روزرسانی شد.";
    }

    private void SetPeriod(string p)
    {
        _period = p;
        _periodLabel = p switch
        {
            "daily" => "روزانه",
            "weekly" => "هفتگی",
            "monthly" => "ماهانه",
            "yearly" => "سالانه",
            _ => "ماهانه"
        };
    }

    private async Task ConfirmRsv(Guid tc)
    {
        await Reservations.ChangeStatusAsync(tc, ReservationStatus.Confirmed);
        await LoadDashboardData();
    }

    private void OpenRefundModal(Tbl_Reservation r)
    {
        _selectedRsvForRefund = r;
        _refundAmount = r.PaidAmount > 0 ? r.PaidAmount : r.PayableAmount;
        _refundRef = $"REF-{DateTime.Now:yyMMddHHmm}";
    }

    private async Task SubmitRefund()
    {
        if (_selectedRsvForRefund is null) return;
        _busy = true;
        await Reservations.CancelWithRefundAsync(_selectedRsvForRefund.Tc, _refundAmount, _refundReason, _refundRef);
        _busy = false;
        _selectedRsvForRefund = null;
        await LoadDashboardData();
    }

    private async Task SubmitInPersonBooking()
    {
        if (string.IsNullOrWhiteSpace(_inpCustomer) || string.IsNullOrWhiteSpace(_inpMobile)) return;
        _busy = true;
        var rsv = new Tbl_Reservation
        {
            CustomerName = _inpCustomer.Trim(),
            MobileNumber = _inpMobile.Trim(),
            ServiceName = _inpService,
            PersonalName = _inpPersonal,
            ReserveDate = _inpDate.Date,
            ReserveTime = _inpTime.TimeOfDay,
            Price = _inpPrice,
            PayableAmount = _inpPrice,
            PaidAmount = _inpPrice,
            PaymentMethod = _inpMethod,
            CustomerNote = _inpNote
        };
        await Reservations.CreateInPersonAsync(rsv);
        _busy = false;
        _showInPersonModal = false;
        await LoadDashboardData();
    }
}
