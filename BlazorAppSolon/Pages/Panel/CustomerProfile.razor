@page "/panel/customer/profile"
@layout BlazorAppSolon.Layout.PanelLayout
@attribute [Authorize(Roles = "Customer")]
@using Microsoft.AspNetCore.Authorization
@using DataLayer.Entity
@using BlazorAppSolon.Data
@inject IDataStore Store
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>پروفایل من | Hadis Beauty</PageTitle>
<h2 class="panel-title">👤 پروفایل من</h2>

<div class="panel-card">
    <AuthorizeView>
        <Authorized>
            @if (_saved)
            {
                <div class="panel-alert ok" style="margin-bottom:1rem">اطلاعات کاربری شما با موفقیت ذخیره شد.</div>
            }
            <div class="form-grid">
                <div class="form-field"><label>نام و نام خانوادگی</label><input class="panel-input" value="@context.User.Identity?.Name" /></div>
                <div class="form-field"><label>شماره موبایل</label><input class="panel-input" dir="ltr" readonly
                    value="@context.User.Claims.FirstOrDefault(c => c.Type.Contains("mobilephone"))?.Value" /></div>
                <div class="form-field"><label>کد معرف</label><input class="panel-input" value="HB2451" readonly /></div>
                <div class="form-field">
                    <label>تاریخ تولد (شمسی)</label>
                    <PersianDatePicker @bind-Value="_birthDate" DisablePast="false" />
                </div>
            </div>
            <button class="btn-solon red" style="margin-top:1.5rem" @onclick="Save">ذخیره تغییرات</button>
        </Authorized>
    </AuthorizeView>
</div>

@code {
    private DateTime _birthDate = DateTime.Today.AddYears(-22);
    private bool _saved = false;

    private void Save()
    {
        _saved = true;
    }
}
