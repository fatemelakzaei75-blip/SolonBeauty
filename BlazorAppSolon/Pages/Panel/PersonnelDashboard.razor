@page "/panel/personnel"
@layout BlazorAppSolon.Layout.PanelLayout
@attribute [Authorize(Roles = "Personnel")]
@using Microsoft.AspNetCore.Authorization
@using DataLayer.Entity
@using BlazorAppSolon.Data
@using DataCore.Helpers
@inject IDataStore Store
@inject ReservationClient Reservations

<PageTitle>داشبورد پرسنل | Hadis Beauty</PageTitle>

<div class="panel-dash-header">
    <h2 class="panel-title">داشبورد و کارتابل پرسنل سالن (بند ۱۷ سند)</h2>
</div>

<div class="stat-grid">
    <div class="stat"><span>🗓</span><b>@_todayCount</b><small>نوبت‌های امروز</small></div>
    <div class="stat"><span>⏳</span><b>@_pendingCount</b><small>در انتظار تأیید</small></div>
    <div class="stat"><span>🖼</span><b>@_portfolioCount</b><small>نمونه‌کار ثبت‌شده</small></div>
    <div class="stat"><span>⭐</span><b>۴.۹</b><small>امتیاز رضایت مشتریان</small></div>
</div>

<!-- کارتابل اعلانات جدید (بند ۱۷ سند) -->
<div class="panel-card" style="margin-top:1.5rem">
    <div class="panel-card-head">
        <h3>🔔 اعلانات و پیام‌های جدید کارتابل (بند ۱۷ سند)</h3>
    </div>
    <div class="notifications-list">
        @foreach (var notif in _notifications.Take(5))
        {
            <div class="notification-item @(notif.IsRead ? "read" : "unread")">
                <span class="notif-badge">🔔</span>
                <div class="notif-content">
                    <div class="notif-title">@notif.Title</div>
                    <div class="notif-body">@notif.Message</div>
                    <small class="notif-date">@PersianDateHelper.ToShamsi(notif.CreatedAt, true)</small>
                </div>
            </div>
        }
        @if (!_notifications.Any())
        {
            <p style="opacity:.7;padding:1rem">پیام جدیدی در کارتابل شما وجود ندارد.</p>
        }
    </div>
</div>

<!-- نوبت‌های پیش رو در کارتابل پرسنل -->
<div class="panel-card" style="margin-top:1.5rem">
    <div class="panel-card-head">
        <h3>نوبت‌های ثبت‌شده برای شما</h3>
        <a class="btn-solon ghost sm" href="panel/personnel/schedule">مشاهده برنامه هفتگی</a>
    </div>

    <div style="overflow-x:auto">
        <table class="panel-table">
            <thead>
                <tr>
                    <th>کد رهگیری</th>
                    <th>نام مشتری</th>
                    <th>خدمت</th>
                    <th>تاریخ (شمسی)</th>
                    <th>ساعت</th>
                    <th>وضعیت</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rsv in _myReservations.Take(5))
                {
                    <tr>
                        <td><code>@rsv.TrackingCode</code></td>
                        <td><strong>@rsv.CustomerName</strong></td>
                        <td>@rsv.ServiceName</td>
                        <td>@PersianDateHelper.ToShamsi(rsv.ReserveDate)</td>
                        <td>@rsv.ReserveTime.ToString(@"hh\:mm")</td>
                        <td><span class="badge @ReservationClient.StatusCss(rsv.Status)">@ReservationClient.StatusLabel(rsv.Status)</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private int _portfolioCount = 0;
    private int _todayCount = 0;
    private int _pendingCount = 0;
    private List<Tbl_Notification> _notifications = new();
    private List<Tbl_Reservation> _myReservations = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _portfolioCount = await Store.CountAsync<Tbl_Portfoilo>();
            _notifications = await Store.AllAsync<Tbl_Notification>();
            _myReservations = await Reservations.MineAsync();

            var today = DateTime.Today;
            _todayCount = _myReservations.Count(r => r.ReserveDate.Date == today);
            _pendingCount = _myReservations.Count(r => r.Status == ReservationStatus.Pending || r.Status == ReservationStatus.PendingPayment);
        }
        catch { }
    }
}
