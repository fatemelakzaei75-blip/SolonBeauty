@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using BlazorAppSolon.Auth
@using BlazorAppSolon.Data
@using DataLayer.Entity
@implements IAsyncDisposable
@inject AuthService Auth
@inject IDataStore Store
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthState

<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

@* data-sidebar-ready تا خوانده‌شدن وضعیت ذخیره‌شده، از پرش بصری جلوگیری می‌کند *@
<div class="panel-shell--capsule"
     data-sidebar="@(_sidebarExpanded ? "expanded" : "rail")"
     data-sidebar-ready="@(_sidebarStateLoaded ? "true" : "false")">

    <!-- ═══ Sidebar کپسولی: دسکتاپ و لپ‌تاپ (≥1024px) ═══ -->
    <PanelSidebar Expanded="_sidebarExpanded"
                  ExpandedChanged="OnSidebarExpandedChanged"
                  UserRole="@_role"
                  LogoUrl="@_logoUrl"
                  BrandName="@_salonName"
                  FallbackMonogram="@_monogram"
                  HomeHref="@_panelHome"
                  BadgeCounts="_badgeCounts"
                  OnLogout="Logout" />

    <!-- هدر مخصوص موبایل با دکمه همبرگری جهت باز کردن سایدبار به صورت Drawer -->
    <header class="panel-mobile-header">
        <button class="panel-mob-toggle" @onclick="OpenDrawer"
                aria-label="منوی پنل" aria-expanded="@_drawerOpen" aria-controls="panel-drawer">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
        </button>

        <a class="panel-mobile-brand" href="">
            <span class="monogram">@_monogram</span>
            <strong>@_salonName</strong>
        </a>

        <AuthorizeView>
            <Authorized>
                <div class="panel-mob-user">
                    <span class="role-badge">
                        @AppRoles.Persian(context.User.Claims.FirstOrDefault(c => c.Type.Contains("role"))?.Value ?? "")
                    </span>
                </div>
            </Authorized>
        </AuthorizeView>
    </header>

    <!-- لایه پس‌زمینه دراور در موبایل -->
    @if (_drawerOpen)
    {
        <div class="panel-drawer-backdrop" @onclick="CloseDrawer"></div>
    }

    <!-- سایدبار پنل (در دسکتاپ ستون کناری و در موبایل کشویی/Drawer) -->
    <aside class="panel-side @(_drawerOpen ? "drawer-open" : "")"
           id="panel-drawer"
           role="dialog"
           aria-modal="true"
           aria-label="منوی پنل کاربری"
           aria-hidden="@(!_drawerOpen)">
        <div class="panel-side-head">
            <a class="panel-logo" href="">
                <span class="monogram">@_monogram</span>
                <small>@_salonName</small>
            </a>
            <button class="panel-drawer-close" @onclick="CloseDrawer" aria-label="بستن منو">✕</button>
        </div>

        <AuthorizeView Roles="Admin">
            <nav class="panel-nav">
                <div class="nav-group">مدیریت کلان سالن</div>
                <NavLink href="panel/admin" Match="NavLinkMatch.All" @onclick="CloseDrawer">📊 داشبورد و شاخص‌ها</NavLink>
                <NavLink href="panel/admin/base-data" @onclick="CloseDrawer">🗂 اطلاعات پایه (بند ۱۹)</NavLink>

                <div class="nav-group">نوبت‌دهی و مراجعین</div>
                <NavLink href="panel/admin/data/reservation" @onclick="CloseDrawer">🗓 مدیریت نوبت‌ها</NavLink>
                <NavLink href="panel/admin/data/waiting-list" @onclick="CloseDrawer">⏳ لیست انتظار</NavLink>
                <NavLink href="panel/admin/data/customer" @onclick="CloseDrawer">👥 پرونده مشتریان</NavLink>

                <div class="nav-group">تیم و خدمات</div>
                <NavLink href="panel/admin/data/personal" @onclick="CloseDrawer">👩‍🎨 پرسنل سالن</NavLink>
                <NavLink href="panel/admin/data/salon-service" @onclick="CloseDrawer">💅 خدمات و تعرفه‌ها</NavLink>
                <NavLink href="panel/admin/data/portfolio" @onclick="CloseDrawer">🖼 گالری نمونه‌کارها</NavLink>

                <div class="nav-group">تنظیمات و تعاملات</div>
                <NavLink href="panel/admin/data/salon-setting" @onclick="CloseDrawer">⚙️ تنظیمات سالن و تم</NavLink>
                <NavLink href="panel/admin/data/discount" @onclick="CloseDrawer">🏷️ کدهای تخفیف</NavLink>
                <NavLink href="panel/admin/data/news-day" @onclick="CloseDrawer">📣 اخبار و وبلاگ</NavLink>
                <NavLink href="panel/admin/data/notification" @onclick="CloseDrawer">🔔 اعلانات سیستم</NavLink>
            </nav>
        </AuthorizeView>

        <AuthorizeView Roles="Personnel">
            <nav class="panel-nav">
                <div class="nav-group">کارتابل پرسنل</div>
                <NavLink href="panel/personnel" Match="NavLinkMatch.All" @onclick="CloseDrawer">📊 داشبورد کاری</NavLink>
                <NavLink href="panel/personnel/schedule" @onclick="CloseDrawer">🗓 کارتابل و نوبت‌ها</NavLink>
                <NavLink href="panel/personnel/portfolio" @onclick="CloseDrawer">🖼 نمونه کارهای من</NavLink>
                <NavLink href="panel/personnel/profile" @onclick="CloseDrawer">👤 مشخصات و ساعت کاری</NavLink>
            </nav>
        </AuthorizeView>

        <AuthorizeView Roles="Customer">
            <nav class="panel-nav">
                <div class="nav-group">حساب کاربری من</div>
                <NavLink href="panel/customer" Match="NavLinkMatch.All" @onclick="CloseDrawer">📊 خلاصه وضعیت</NavLink>
                <NavLink href="panel/customer/appointments" @onclick="CloseDrawer">🗓 نوبت‌های رزرو شده</NavLink>
                <NavLink href="panel/customer/favorites" @onclick="CloseDrawer">❤️ علاقه‌مندی‌ها</NavLink>
                <NavLink href="panel/customer/profile" @onclick="CloseDrawer">👤 اطلاعات حساب</NavLink>
            </nav>
        </AuthorizeView>

        <div class="panel-side-footer">
            <button class="logout" @onclick="Logout">خروج از حساب</button>
            <a class="btn-solon ghost sm full-width" href="" style="margin-top:0.5rem; text-align:center;">صفحه اصلی سایت</a>
        </div>
    </aside>

    <section class="panel-content">
        <header class="panel-top">
            <AuthorizeView>
                <Authorized>
                    <div style="display:flex;align-items:center;gap:.75rem">
                        <strong>@context.User.Identity?.Name</strong>
                        <span class="role-chip">
                            @AppRoles.Persian(context.User.Claims.FirstOrDefault(c => c.Type.Contains("role"))?.Value ?? "")
                        </span>
                    </div>
                </Authorized>
            </AuthorizeView>
            <div style="display:flex;align-items:center;gap:1rem;">
                <span class="conn-dot @(Store.IsOnline ? "" : "offline")">
                    <i></i>@(Store.IsOnline ? "متصل به WebApi" : "داده نمونه (آفلاین)")
                </span>
                <a class="btn-solon ghost sm" href="">مشاهده سایت اصلی</a>
            </div>
        </header>

        <div class="panel-body">
            @Body
        </div>
    </section>

    <!-- نوار ناوبری پایین صفحه مخصوص پنل در موبایل (Panel Mobile Bottom Nav) -->
    <div class="panel-bottom-nav">
        <AuthorizeView Roles="Admin">
            <NavLink href="panel/admin" Match="NavLinkMatch.All" class="panel-bnav-item">
                <span class="bnav-icon">📊</span>
                <span>شاخص‌ها</span>
            </NavLink>
            <NavLink href="panel/admin/data/reservation" class="panel-bnav-item">
                <span class="bnav-icon">🗓</span>
                <span>نوبت‌ها</span>
            </NavLink>
            <NavLink href="panel/admin/base-data" class="panel-bnav-item">
                <span class="bnav-icon">🗂</span>
                <span>پایه‌ها</span>
            </NavLink>
            <NavLink href="panel/admin/data/notification" class="panel-bnav-item">
                <span class="bnav-icon">🔔</span>
                <span>اعلانات</span>
            </NavLink>
            <button type="button" class="panel-bnav-item bnav-btn" @onclick="OpenDrawer">
                <span class="bnav-icon">☰</span>
                <span>منو</span>
            </button>
        </AuthorizeView>

        <AuthorizeView Roles="Personnel">
            <NavLink href="panel/personnel" Match="NavLinkMatch.All" class="panel-bnav-item">
                <span class="bnav-icon">📊</span>
                <span>داشبورد</span>
            </NavLink>
            <NavLink href="panel/personnel/schedule" class="panel-bnav-item">
                <span class="bnav-icon">🗓</span>
                <span>نوبت‌ها</span>
            </NavLink>
            <NavLink href="panel/personnel/portfolio" class="panel-bnav-item">
                <span class="bnav-icon">🖼</span>
                <span>نمونه‌کار</span>
            </NavLink>
            <NavLink href="panel/personnel/profile" class="panel-bnav-item">
                <span class="bnav-icon">👤</span>
                <span>پروفایل</span>
            </NavLink>
            <button type="button" class="panel-bnav-item bnav-btn" @onclick="OpenDrawer">
                <span class="bnav-icon">☰</span>
                <span>منو</span>
            </button>
        </AuthorizeView>

        <AuthorizeView Roles="Customer">
            <NavLink href="panel/customer" Match="NavLinkMatch.All" class="panel-bnav-item">
                <span class="bnav-icon">📊</span>
                <span>داشبورد</span>
            </NavLink>
            <NavLink href="panel/customer/appointments" class="panel-bnav-item">
                <span class="bnav-icon">🗓</span>
                <span>نوبت‌های من</span>
            </NavLink>
            <NavLink href="panel/customer/favorites" class="panel-bnav-item">
                <span class="bnav-icon">❤️</span>
                <span>علاقه‌ها</span>
            </NavLink>
            <NavLink href="panel/customer/profile" class="panel-bnav-item">
                <span class="bnav-icon">👤</span>
                <span>حساب</span>
            </NavLink>
            <button type="button" class="panel-bnav-item bnav-btn" @onclick="OpenDrawer">
                <span class="bnav-icon">☰</span>
                <span>منو</span>
            </button>
        </AuthorizeView>
    </div>
</div>

@code {
    private bool _drawerOpen = false;
    private bool _scrollLocked;
    private DotNetObjectReference<PanelLayout>? _selfRef;

    // ---------- وضعیت Sidebar کپسولی ----------
    private bool _sidebarExpanded = true;   // پیش‌فرض تا خوانده‌شدن وضعیت واقعی
    private bool _sidebarStateLoaded;
    private string? _role;
    private string _salonName = "سالن زیبایی حدیث";
    private string _monogram = "HB";
    private string? _logoUrl;
    private IReadOnlyDictionary<string, int>? _badgeCounts;

    /// <summary>آدرس خانه‌ی پنل بر اساس نقش — مقصد کلیک روی لوگو</summary>
    private string _panelHome => AppRoles.PanelUrl(_role ?? AppRoles.Customer);

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _role = state.User.Claims.FirstOrDefault(c => c.Type.Contains("role"))?.Value;

        // نام سالن و لوگو از تنظیمات؛ در نبود سرویس، برند پیش‌فرض و مونوگرام می‌ماند
        try
        {
            var settings = await Store.AllAsync<Tbl_SalonSetting>();
            var s = settings.FirstOrDefault();
            if (s is not null)
            {
                if (!string.IsNullOrWhiteSpace(s.SalonName)) _salonName = s.SalonName;
                if (!string.IsNullOrWhiteSpace(s.LogoUrl)) _logoUrl = s.LogoUrl;
            }
        }
        catch { }

        // شمارش اعلان‌های خوانده‌نشده همان نقش برای Badge منو
        try
        {
            var notifications = await Store.AllAsync<Tbl_Notification>();
            var unread = notifications.Count(n =>
                n.IsActive && !n.IsRead &&
                (string.IsNullOrWhiteSpace(n.TargetRole) || n.TargetRole == _role));

            if (unread > 0)
            {
                _badgeCounts = new Dictionary<string, int> { ["notifications"] = unread };
            }
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // اگر کاربر دستگاه را به حالت تبلت/دسکتاپ بچرخاند، منوی کشویی
        // نباید روی صفحه بزرگ «گیر» کند.
        _selfRef = DotNetObjectReference.Create(this);
        await SafeInvokeAsync("solonUx.watchViewport", _selfRef);

        await LoadSidebarStateAsync();
    }

    /// <summary>
    /// بازیابی وضعیت Sidebar: اگر کاربر قبلاً دستی باز/بسته کرده باشد همان
    /// حفظ می‌شود؛ وگرنه پیش‌فرض از عرض صفحه می‌آید — دسکتاپ عریض باز و
    /// لپ‌تاپ و تبلت افقی بسته (Rail).
    /// </summary>
    private async Task LoadSidebarStateAsync()
    {
        try
        {
            var stored = await JS.InvokeAsync<string?>("solonUx.getSidebarState");
            _sidebarExpanded = string.IsNullOrEmpty(stored)
                ? await JS.InvokeAsync<bool>("solonUx.isWideDesktop")
                : stored == "expanded";
        }
        catch (JSDisconnectedException) { /* اتصال قطع شده است */ }
        catch (InvalidOperationException) { /* JS در دسترس نیست */ }

        _sidebarStateLoaded = true;
        StateHasChanged();
    }

    /// <summary>تغییر وضعیت توسط کاربر — در localStorage ذخیره می‌شود</summary>
    private async Task OnSidebarExpandedChanged(bool expanded)
    {
        _sidebarExpanded = expanded;
        await SafeInvokeAsync("solonUx.setSidebarState", expanded ? "expanded" : "rail");
    }

    /// <summary>باز کردن منوی کشویی پنل + قفل اسکرول پس‌زمینه</summary>
    private async Task OpenDrawer()
    {
        _drawerOpen = true;
        if (!_scrollLocked)
        {
            _scrollLocked = true;
            await SafeInvokeAsync("solonUx.setScrollLock", true);
        }
    }

    /// <summary>بستن منوی کشویی پنل + آزادسازی اسکرول پس‌زمینه</summary>
    private async Task CloseDrawer()
    {
        if (!_drawerOpen) return;
        _drawerOpen = false;
        if (_scrollLocked)
        {
            _scrollLocked = false;
            await SafeInvokeAsync("solonUx.setScrollLock", false);
        }
    }

    /// <summary>فراخوانی امن JS — خطاهای قطع اتصال باعث کرش کامپوننت نشوند</summary>
    private async Task SafeInvokeAsync(string identifier, params object?[] args)
    {
        try
        {
            await JS.InvokeVoidAsync(identifier, args);
        }
        catch (JSDisconnectedException) { /* اتصال قطع شده است */ }
        catch (InvalidOperationException) { /* JS در دسترس نیست */ }
    }

    /// <summary>از سمت JS صدا زده می‌شود وقتی Viewport از حد تبلت عبور کرد</summary>
    [JSInvokable]
    public async Task OnViewportBecameDesktop() => await CloseDrawer();

    private async Task Logout()
    {
        await CloseDrawer();
        await Auth.LogoutAsync();
        Nav.NavigateTo("", forceLoad: false);
    }

    public async ValueTask DisposeAsync()
    {
        if (_scrollLocked) await SafeInvokeAsync("solonUx.setScrollLock", false);

        await SafeInvokeAsync("solonUx.unwatchViewport");
        _selfRef?.Dispose();
    }
}
