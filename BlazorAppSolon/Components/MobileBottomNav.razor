@using Microsoft.AspNetCore.Components.Authorization
@using BlazorAppSolon.Auth
@inject NavigationManager Nav

<div class="mobile-bottom-nav">
    <NavLink href="" Match="NavLinkMatch.All" class="mob-nav-item">
        <svg class="mob-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
        <span>خانه</span>
    </NavLink>

    <NavLink href="services" class="mob-nav-item">
        <svg class="mob-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
        </svg>
        <span>خدمات</span>
    </NavLink>

    <NavLink href="reserve" class="mob-nav-item center-cta" title="رزرو وقت نوبت">
        <div class="center-cta-circle">
            <svg class="mob-nav-icon cta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
        </div>
        <span class="cta-label">رزرو نوبت</span>
    </NavLink>

    <NavLink href="gallery" class="mob-nav-item">
        <svg class="mob-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <polyline points="21 15 16 10 5 21"></polyline>
        </svg>
        <span>نمونه‌کارها</span>
    </NavLink>

    <AuthorizeView>
        <Authorized>
            <NavLink href="@AppRoles.PanelUrl(context.User.Claims.FirstOrDefault(c => c.Type.Contains("role"))?.Value ?? "")" class="mob-nav-item">
                <svg class="mob-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
                <span>پنل من</span>
            </NavLink>
        </Authorized>
        <NotAuthorized>
            <NavLink href="login" class="mob-nav-item">
                <svg class="mob-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                    <polyline points="10 17 15 12 10 7"></polyline>
                    <line x1="15" y1="12" x2="3" y2="12"></line>
                </svg>
                <span>ورود</span>
            </NavLink>
        </NotAuthorized>
    </AuthorizeView>
</div>
