@* ==========================================================================
   AuthAlert — پیام سطح فرم صفحه ورود
   --------------------------------------------------------------------------
   برای پیام‌هایی که به یک فیلد خاص وصل نیستند: «شماره یا رمز نادرست است»،
   «کد تأیید ارسال شد»، «رمز عبور تغییر کرد».

   چرا role="alert" و نه aria-live دستی:
   role=alert خودش یک ناحیه زنده با اولویت بالا است؛ همان چیزی که بریف برای
   خطاها خواسته. توجه: پیام موفق هم در همین ناحیه می‌آید و اعلام می‌شود —
   چون «کد ارسال شد» اطلاعی است که کاربر منتظرش است و باید شنیده شود.

   چرا پیام خالی اصلاً رندر نمی‌شود:
   ناحیه زنده‌ای که از ابتدا خالی در DOM باشد و بعد پر شود، بهتر اعلام
   می‌شود؛ ولی عنصر کاملاً خالی در بعضی صفحه‌خوان‌ها فاصله بی‌دلیل می‌سازد.
   پس فقط وقتی پیام هست رندر می‌شود.
   ========================================================================== *@

@if (!string.IsNullOrEmpty(Message))
{
    <div class="lg-alert lg-alert--@(Kind == "ok" ? "ok" : "error")" role="alert">
        <AuthIcons Name="@(Kind == "ok" ? "check" : "alert")" Class="lg-alert__icon" />
        <span>@Message</span>
    </div>
}

@code {
    [Parameter] public string? Message { get; set; }

    /// <summary>ok | error — هر مقدار دیگری به خطا تفسیر می‌شود.</summary>
    [Parameter] public string Kind { get; set; } = "error";
}
