@* ==========================================================================
   AuthIcons — آیکون‌های برداری صفحه ورود
   --------------------------------------------------------------------------
   چرا کامپوننت جدا: چهار جای صفحه ورود به آیکون نیاز دارند (فیلد موبایل،
   فیلد رمز، دکمه نمایش رمز، پیام خطا). اگر هر جا SVG جداگانه نوشته شود،
   ضخامت خط و اندازه‌ها دیر یا زود از هم می‌افتند. همه از یک جا می‌آیند.

   الگو از PanelNavIcons همین پروژه گرفته شده (سوئیچ روی نام).

   همه آیکون‌ها aria-hidden هستند: هیچ‌کدام حامل اطلاعات نیستند و برچسب
   فیلد یا aria-label دکمه، معنا را می‌رساند. اگر آیکون هم اعلام شود،
   صفحه‌خوان دو بار می‌خواند.
   ========================================================================== *@

<svg class="@Class" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "phone":
            <rect x="7" y="2.5" width="10" height="19" rx="2.6" />
            <path d="M10.6 5.3h2.8" />
            <path d="M11.2 18.6h1.6" />
            break;

        case "lock":
            <rect x="4.6" y="10" width="14.8" height="10.4" rx="3" />
            <path d="M8.2 10V7.5a3.8 3.8 0 0 1 7.6 0V10" />
            <path d="M12 14.1v2.3" />
            break;

        case "eye":
            <path d="M2.3 12S5.7 5.7 12 5.7 21.7 12 21.7 12 18.3 18.3 12 18.3 2.3 12 2.3 12Z" />
            <circle cx="12" cy="12" r="3.1" />
            break;

        case "eye-off":
            <path d="M4 4l16 16" />
            <path d="M9.8 5.95A9.6 9.6 0 0 1 12 5.7c6.3 0 9.7 6.3 9.7 6.3a17.3 17.3 0 0 1-3.4 4.2" />
            <path d="M6.4 7.75A17.5 17.5 0 0 0 2.3 12S5.7 18.3 12 18.3c1.25 0 2.36-.19 3.35-.53" />
            <path d="M10.05 10.15a3.1 3.1 0 0 0 4.3 4.3" />
            break;

        case "alert":
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7.7v5.1" />
            <circle cx="12" cy="16.2" r="1" fill="currentColor" stroke="none" />
            break;

        case "check":
            <circle cx="12" cy="12" r="9" />
            <path d="M8.2 12.3l2.6 2.6 5-5.2" />
            break;

        case "key":
            <circle cx="8.6" cy="15.4" r="3.6" />
            <path d="M11.2 12.8 19 5" />
            <path d="M16.4 7.6l1.8 1.8" />
            <path d="M18.9 5.1l1.8 1.8" />
            break;

        case "close":
            <path d="M6.4 6.4l11.2 11.2" />
            <path d="M17.6 6.4L6.4 17.6" />
            break;

        case "sparkle":
            @* نقش‌مایه تزئینی برند برای حالت جایگزین تصویر (مرحله ۷) *@
            <path d="M12 3.4c.8 3.9 2.3 5.4 6.2 6.2-3.9.8-5.4 2.3-6.2 6.2-.8-3.9-2.3-5.4-6.2-6.2 3.9-.8 5.4-2.3 6.2-6.2Z" />
            <path d="M17.6 15.4c.4 1.9 1.1 2.6 3 3-1.9.4-2.6 1.1-3 3-.4-1.9-1.1-2.6-3-3 1.9-.4 2.6-1.1 3-3Z" />
            break;
    }
</svg>

@code {
    /// <summary>نام آیکون: phone | lock | eye | eye-off | alert | check | key | close | sparkle</summary>
    [Parameter] public string Name { get; set; } = "phone";

    /// <summary>کلاس CSS؛ اندازه و رنگ از بیرون تعیین می‌شود تا یک آیکون در جاهای مختلف اندازه‌های مختلف بگیرد.</summary>
    [Parameter] public string? Class { get; set; }
}
