@* ==========================================================================
   PasswordField — فیلد رمز عبور با دکمه نمایش/پنهان‌سازی
   --------------------------------------------------------------------------
   این کامپوننت خودش چیدمان نمی‌سازد؛ CapsuleField را با نوع متغیر صدا می‌زند
   و دکمه چشم را داخل کپسول می‌گذارد. چرا: تکرار چیدمان کپسول در دو فایل
   یعنی دو جا برای از هم افتادن.

   چرا دکمه چشم tabindex عادی دارد:
   کاربر کیبوردی باید بتواند رمز را بررسی کند. اگر دکمه از ترتیب Tab بیرون
   می‌ماند، این کار فقط با ماوس ممکن بود.

   چرا aria-pressed هم دارد به‌علاوه aria-label:
   aria-label وضعیت فعلی را می‌گوید («نمایش رمز عبور» وقتی پنهان است) و
   aria-pressed حالت دکمه‌ی فشاری را. صفحه‌خوان‌ها این دو را متفاوت اعلام
   می‌کنند و با هم، تصویر کامل می‌دهند.
   ========================================================================== *@

<CapsuleField Id="@Id"
              Label="@Label"
              Type="@(_visible ? "text" : "password")"
              Name="@Name"
              Value="@Value"
              ValueChanged="@ValueChanged"
              Placeholder="@Placeholder"
              InputMode="text"
              Autocomplete="@Autocomplete"
              EnterKeyHint="done"
              Dir="ltr"
              MaxLength="@MaxLength"
              Disabled="@Disabled"
              Required="@Required"
              IconName="lock"
              Hint="@Hint"
              Error="@Error"
              CssClass="@CssClass">
    @* دکمه باید نوع button باشد؛ در غیر این صورت داخل فرم نقش submit می‌گیرد
       و زدنش فرم را ارسال می‌کند. *@
    <button type="button"
            class="lg-field__eye"
            aria-label="@(_visible ? "پنهان کردن رمز عبور" : "نمایش رمز عبور")"
            aria-pressed="@(_visible ? "true" : "false")"
            aria-controls="@Id"
            disabled="@Disabled"
            @onclick="Toggle">
        <AuthIcons Name="@(_visible ? "eye-off" : "eye")" />
    </button>
</CapsuleField>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string Label { get; set; } = "رمز عبور";

    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    [Parameter] public string? Placeholder { get; set; }

    [Parameter] public string? Name { get; set; }

    /// <summary>پیش‌فرض current-password. در فرم تعیین رمز تازه، new-password بدهید.</summary>
    [Parameter] public string Autocomplete { get; set; } = "current-password";

    [Parameter] public int? MaxLength { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public bool Required { get; set; }

    [Parameter] public string? Hint { get; set; }

    [Parameter] public string? Error { get; set; }

    [Parameter] public string? CssClass { get; set; }

    /// <summary>آیا رمز در حال حاضر دیده می‌شود.</summary>
    private bool _visible;

    /// <summary>
    /// تغییر حالت نمایش. مقدار رمز دست‌نخورده می‌ماند؛ فقط نوع ورودی عوض
    /// می‌شود و مرورگر آن را با همان مقدار بازسازی می‌کند.
    /// </summary>
    private void Toggle() => _visible = !_visible;
}
