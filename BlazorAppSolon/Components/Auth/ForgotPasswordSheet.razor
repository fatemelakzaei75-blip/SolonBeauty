@* ==========================================================================
   ForgotPasswordSheet — بازیابی رمز عبور
   --------------------------------------------------------------------------
   در موبایل «برگ پایین» (bottom sheet) است و در دسکتاپ پنجره میانی — همان
   الگویی که بریف برای موبایل خواسته. تفاوت فقط CSS است؛ ساختار یکی است.
   (کلاس lg-sheet در login.css همین دو حالت را دارد.)

   کامپوننت بی‌حالت است: مقدارها، خطاها، حالت بارگذاری و پیام از صفحه ورود
   می‌آیند و رویدادها به بالا می‌روند. چرا: اعتبارسنجی فارسی و فراخوانی API
   باید در یک جا باشد؛ اگر این برگه هم خودش API صدا بزند، دو مسیر موازی برای
   یک کار خواهیم داشت.

   دسترس‌پذیری:
   - role="dialog" + aria-modal="true" + aria-labelledby
   - دکمه بستن برچسب متنی دارد (aria-label) و هدف لمسش ۴۴ پیکسل است
   - کلید Escape برگه را می‌بندد (فوکوس داخل برگه است، پس رویداد بالاپخش می‌شود)
   - فوکوس اولیه: صفحه ورود بعد از باز کردن، فوکوس را روی فیلد اول می‌گذارد
     (صفحه دسترسی به ref فیلد دارد؛ جزئیات در Login.razor)
   ========================================================================== *@

@if (Visible)
{
    <div class="lg-sheet" @onkeydown="OnKeyDown">
        @* پس‌زمینه تاریک؛ کلیک روی آن هم می‌بندد *@
        <div class="lg-sheet__scrim" @onclick="CloseAsync" aria-hidden="true"></div>

        <div class="lg-sheet__panel" role="dialog" aria-modal="true" aria-labelledby="lg-sheet-title">

            <header class="lg-sheet__head">
                <h2 class="lg-sheet__title" id="lg-sheet-title">بازیابی رمز عبور</h2>
                <button type="button" class="lg-sheet__close" aria-label="بستن پنجره بازیابی"
                        @onclick="CloseAsync">
                    <AuthIcons Name="close" Class="lg-sheet__close-icon" />
                </button>
            </header>

            <p class="lg-sheet__lead">
                شماره موبایل را وارد کنید، کد پیامک‌شده را ثبت کنید و رمز عبور جدید را تعیین فرمایید.
            </p>

            <form class="lg-form" @onsubmit="SubmitAsync" @onsubmit:preventDefault>

                <div class="lg-form__fields">
                    <CapsuleField Id="lg-reset-mobile"
                                  Label="شماره موبایل"
                                  Type="tel"
                                  @ref="_mobileField"
                                  @bind-Value="Mobile"
                                  Placeholder="09xxxxxxxxx"
                                  InputMode="tel"
                                  Autocomplete="tel"
                                  EnterKeyHint="next"
                                  Dir="ltr"
                                  IconName="phone"
                                  Required="true"
                                  Error="@MobileError" />

                    <CapsuleField Id="lg-reset-code"
                                  Label="کد تأیید پیامکی"
                                  Type="text"
                                  @bind-Value="Code"
                                  Placeholder="۱۲۳۴۵"
                                  InputMode="numeric"
                                  Autocomplete="one-time-code"
                                  EnterKeyHint="next"
                                  MaxLength="5"
                                  Dir="ltr"
                                  IconName="key"
                                  Required="true"
                                  Error="@CodeError" />

                    <CapsuleField Id="lg-reset-password"
                                  Label="رمز عبور جدید"
                                  Type="password"
                                  @bind-Value="NewPassword"
                                  Placeholder="حداقل ۶ کاراکتر"
                                  Autocomplete="new-password"
                                  EnterKeyHint="done"
                                  Dir="ltr"
                                  IconName="lock"
                                  Required="true"
                                  Error="@PasswordError"
                                  Hint="رمز عبور جدید باید حداقل ۶ کاراکتر باشد." />
                </div>

                <AuthAlert Message="@Message" Kind="@MessageKind" />

                <AuthButton Text="ذخیره رمز جدید"
                            Type="submit"
                            Block="true"
                            Loading="@Loading"
                            LoadingText="در حال ذخیره…" />
            </form>

            <AuthButton Text="انصراف"
                        Variant="ghost"
                        Block="true"
                        Disabled="@Loading"
                        OnClick="CloseAsync" />
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }

    [Parameter] public string? Mobile { get; set; }
    [Parameter] public EventCallback<string?> MobileChanged { get; set; }

    [Parameter] public string? Code { get; set; }
    [Parameter] public EventCallback<string?> CodeChanged { get; set; }

    [Parameter] public string? NewPassword { get; set; }
    [Parameter] public EventCallback<string?> NewPasswordChanged { get; set; }

    [Parameter] public string? MobileError { get; set; }
    [Parameter] public string? CodeError { get; set; }
    [Parameter] public string? PasswordError { get; set; }

    [Parameter] public string? Message { get; set; }

    /// <summary>ok | error</summary>
    [Parameter] public string MessageKind { get; set; } = "error";

    [Parameter] public bool Loading { get; set; }

    [Parameter] public EventCallback OnSubmit { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>فوکوس اولیه روی فیلد شماره موبایل — صفحه ورود آن را صدا می‌زند.</summary>
    public ValueTask FocusFirstFieldAsync()
        => Visible && _mobileField is not null
            ? _mobileField.FocusAsync()
            : ValueTask.CompletedTask;

    private CapsuleField? _mobileField;

    private async Task SubmitAsync() => await OnSubmit.InvokeAsync();

    private async Task CloseAsync() => await OnClose.InvokeAsync();

    /// <summary>Escape برگه را می‌بندد. کلیدهای دیگر دست‌نخورده عبور می‌کنند.</summary>
    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await OnClose.InvokeAsync();
    }
}
