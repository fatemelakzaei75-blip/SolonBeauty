@using DataCore.Helpers
@using System.Globalization

<div class="shamsi-picker-wrap">
    <div class="shamsi-input-box" @onclick="ToggleDropdown">
        <span class="calendar-icon">📅</span>
        <span class="shamsi-display-text">@(PersianDateHelper.ToShamsi(Value)) (@PersianDateHelper.ToShamsiLong(Value))</span>
        <span class="dropdown-chevron">▼</span>
    </div>

    @if (_isOpen)
    {
        <div class="shamsi-dropdown">
            <div class="calendar-header">
                <button type="button" class="cal-nav-btn" @onclick="NextMonth">❮</button>
                <div class="cal-title">
                    <span>@PersianDateHelper.GetMonthName(_currentMonth)</span>
                    <span>@_currentYear</span>
                </div>
                <button type="button" class="cal-nav-btn" @onclick="PrevMonth">❯</button>
            </div>

            <div class="calendar-weekdays">
                <span>ش</span><span>ی</span><span>د</span><span>س</span><span>چ</span><span>پ</span><span>ج</span>
            </div>

            <div class="calendar-days-grid">
                @for (int p = 0; p < _emptyLeadingDays; p++)
                {
                    <span class="day-empty"></span>
                }
                @for (int d = 1; d <= _daysInMonth; d++)
                {
                    var dayNum = d;
                    var dateObj = PersianDateHelper.ToMiladi(_currentYear, _currentMonth, dayNum);
                    var isSelected = (Value.Date == dateObj.Date);
                    var isPast = (DisablePast && dateObj.Date < DateTime.Today);

                    <button type="button"
                            class="day-btn @(isSelected ? "selected" : "") @(isPast ? "disabled" : "")"
                            disabled="@isPast"
                            @onclick="@(() => SelectDay(dayNum))">
                        @dayNum
                    </button>
                }
            </div>

            <div class="calendar-footer">
                <button type="button" class="cal-today-btn" @onclick="GoToToday">امروز</button>
                <button type="button" class="cal-close-btn" @onclick="Close">تأیید</button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public DateTime Value { get; set; } = DateTime.Today.AddDays(1);
    [Parameter] public EventCallback<DateTime> ValueChanged { get; set; }
    [Parameter] public bool DisablePast { get; set; } = true;

    private bool _isOpen = false;
    private int _currentYear;
    private int _currentMonth;
    private int _daysInMonth;
    private int _emptyLeadingDays;

    protected override void OnInitialized()
    {
        var (y, m, _) = PersianDateHelper.GetShamsiParts(Value == default ? DateTime.Today : Value);
        _currentYear = y;
        _currentMonth = m;
        CalculateMonth();
    }

    private void ToggleDropdown()
    {
        _isOpen = !_isOpen;
        if (_isOpen)
        {
            var (y, m, _) = PersianDateHelper.GetShamsiParts(Value == default ? DateTime.Today : Value);
            _currentYear = y;
            _currentMonth = m;
            CalculateMonth();
        }
    }

    private void Close() => _isOpen = false;

    private void CalculateMonth()
    {
        _daysInMonth = _currentMonth <= 6 ? 31 : (_currentMonth <= 11 ? 30 : 29);
        var firstDayMiladi = PersianDateHelper.ToMiladi(_currentYear, _currentMonth, 1);
        int dow = (int)firstDayMiladi.DayOfWeek; // 0=Sunday, 6=Saturday
        // In Persian calendar: Saturday=0, Sunday=1, Monday=2, Tuesday=3, Wednesday=4, Thursday=5, Friday=6
        _emptyLeadingDays = (dow + 1) % 7;
    }

    private void NextMonth()
    {
        _currentMonth++;
        if (_currentMonth > 12)
        {
            _currentMonth = 1;
            _currentYear++;
        }
        CalculateMonth();
    }

    private void PrevMonth()
    {
        _currentMonth--;
        if (_currentMonth < 1)
        {
            _currentMonth = 12;
            _currentYear--;
        }
        CalculateMonth();
    }

    private async Task SelectDay(int day)
    {
        var newDate = PersianDateHelper.ToMiladi(_currentYear, _currentMonth, day);
        Value = newDate;
        await ValueChanged.InvokeAsync(newDate);
        _isOpen = false;
    }

    private async Task GoToToday()
    {
        var today = DateTime.Today;
        var (y, m, d) = PersianDateHelper.GetShamsiParts(today);
        _currentYear = y;
        _currentMonth = m;
        CalculateMonth();
        await SelectDay(d);
    }
}
