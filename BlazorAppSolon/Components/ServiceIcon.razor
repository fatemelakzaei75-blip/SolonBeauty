@* آیکون های خطی مینیمال خدمات — بدون تصویر واقعی (بند ۶ بریف) *@

<svg viewBox="0 0 64 64" fill="none" stroke="#1A1A1A" stroke-width="1.3"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Name)
    {
        case "bride":
            <path d="M32 14c8 0 13 6 13 13 0 9-6 16-13 16s-13-7-13-16c0-7 5-13 13-13z" />
            <path d="M19 24c6 0 10-3 13-7 3 4 7 7 13 7" />
            <path d="M26 31h3M35 31h3M27 37c3 2 7 2 10 0" />
            <path d="M14 54c4-6 11-9 18-9s14 3 18 9" />
            break;
        case "makeup":
            <path d="M24 12h8l2 10H22l2-10z" /><path d="M22 22h12v28a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V22z" />
            <path d="M44 14c3 4 4 8 4 12s-1 6-4 6-4-2-4-6 1-8 4-12z" /><path d="M44 32v20" />
            break;
        case "shinion":
            <path d="M32 10c11 0 18 8 18 18 0 12-8 16-8 22H22c0-6-8-10-8-22 0-10 7-18 18-18z" />
            <circle cx="32" cy="22" r="7" /><path d="M20 34c5 4 19 4 24 0" />
            break;
        case "color":
            <path d="M32 8s12 14 12 22a12 12 0 0 1-24 0C20 22 32 8 32 8z" /><path d="M26 32c0 5 3 8 7 9" />
            break;
        case "keratin":
            <path d="M20 12c0 14-6 18-6 28a18 18 0 0 0 36 0c0-10-6-14-6-28" />
            <path d="M26 24c4 6 4 14 0 22M38 24c-4 6-4 14 0 22" />
            break;
        case "cut":
            <circle cx="20" cy="46" r="6" /><circle cx="44" cy="46" r="6" />
            <path d="M24 42L44 14M40 42L20 14" />
            break;
        case "lash":
            <path d="M8 36c8-10 16-15 24-15s16 5 24 15" />
            <path d="M14 30l-4 8M24 24l-3 10M34 22v12M44 24l3 10M54 30l4 8" />
            break;
        case "lift":
            <path d="M8 40c8-12 16-18 24-18s16 6 24 18" /><circle cx="32" cy="34" r="6" />
            <path d="M32 14v-6M20 18l-3-5M44 18l3-5" />
            break;
        case "laminate":
            <path d="M10 34c8-8 14-12 22-12s14 4 22 12" /><path d="M10 42c8-8 14-12 22-12s14 4 22 12" />
            break;
        case "massage":
            <circle cx="32" cy="18" r="7" /><path d="M14 50c2-10 9-16 18-16s16 6 18 16" />
            <path d="M22 44c4-3 16-3 20 0" />
            break;
        case "hairtexture":
            <path d="M18 12c-4 10 4 12 0 22s4 12 0 18M32 10c-4 10 4 12 0 22s4 12 0 18M46 12c-4 10 4 12 0 22s4 12 0 18" />
            break;
        case "hairext":
            <path d="M22 12h20l-3 8H25l-3-8z" /><path d="M25 20c-3 12 2 18-1 30M32 20c-3 12 2 18-1 30M39 20c-3 12 2 18-1 30" />
            break;
        case "brushing":
            <rect x="14" y="16" width="26" height="14" rx="7" /><path d="M40 23h10" />
            <path d="M18 30v8M24 30v8M30 30v8M36 30v8" /><path d="M14 46h28" />
            break;
        case "facial":
            <path d="M32 10c9 0 15 7 15 17 0 13-8 25-15 25S17 40 17 27c0-10 6-17 15-17z" />
            <path d="M26 28c1.5-2 4-2 5 0M33 28c1.5-2 4-2 5 0" /><path d="M28 40c3 2 6 2 9 0" />
            break;
        case "permanent":
            <path d="M14 46l6 6 30-30a4.2 4.2 0 0 0-6-6L14 46z" /><path d="M14 46l-4 10 10-4" />
            <path d="M40 16l6 6" />
            break;
        case "nail":
            <path d="M24 16a8 8 0 0 1 16 0v22c0 7-4 12-8 12s-8-5-8-12V16z" />
            <path d="M24 26c5-3 11-3 16 0" />
            break;
        default:
            <circle cx="32" cy="32" r="16" />
            break;
    }
</svg>

@code {
    [Parameter] public string Name { get; set; } = "";
}
