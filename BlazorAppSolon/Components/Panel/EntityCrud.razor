@typeparam TEntity where TEntity : DataLayer.Entity.BaseEntity.Tbl_BaseEntity
@using System.Reflection
@using System.ComponentModel.DataAnnotations
@using DataLayer.Entity.BaseEntity
@using DataCore.Helpers
@using DataLayer.Entity
@inject BlazorAppSolon.Data.IDataStore Store

<div class="panel-card">
    <div class="panel-card-head">
        <h3>@Title <span class="source-chip">@(Store.IsOnline ? "متصل به سرویس" : "داده نمونه (آفلاین)")</span></h3>
        <div style="display:flex;gap:.6rem;align-items:center;">
            <input class="panel-input" style="width:220px" placeholder="جستجو..." @bind="_search" @bind:event="oninput" />
            <button class="btn-solon" @onclick="StartCreate">+ رکورد جدید</button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="panel-alert">@_message</div>
    }

    <div style="overflow-x:auto;">
        <table class="panel-table">
            <thead>
                <tr>
                    <th>#</th>
                    @foreach (var p in Columns)
                    {
                        <th>@Label(p)</th>
                    }
                    <th>وضعیت</th>
                    <th>تاریخ ثبت (شمسی)</th>
                    <th style="width:120px">عملیات</th>
                </tr>
            </thead>
            <tbody>
                @{ var rows = Filtered(); var i = 1; }
                @foreach (var item in rows)
                {
                    <tr>
                        <td>@(i++)</td>
                        @foreach (var p in Columns)
                        {
                            <td>
                                @if (IsImageField(p.Name) && p.GetValue(item) is string img && !string.IsNullOrWhiteSpace(img))
                                {
                                    <img class="cell-thumb" src="@img" alt="" />
                                }
                                else
                                {
                                    @DisplayValue(p, p.GetValue(item))
                                }
                            </td>
                        }
                        <td>
                            <span class="badge @(item.IsActive ? "ok" : "off")">@(item.IsActive ? "فعال" : "غیرفعال")</span>
                        </td>
                        <td>@PersianDateHelper.ToShamsi(item.RegisterData)</td>
                        <td class="row-actions">
                            <button class="mini" @onclick="() => StartEdit(item)">ویرایش</button>
                            <button class="mini danger" @onclick="async () => await Remove(item)">حذف</button>
                        </td>
                    </tr>
                }
                @if (rows.Count == 0)
                {
                    <tr><td colspan="@(Columns.Count + 4)" style="text-align:center;opacity:.6">
                        @(_loading ? "در حال دریافت اطلاعات..." : "رکوردی ثبت نشده است")
                    </td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (_editing is not null)
{
    <div class="modal-backdrop" @onclick="Cancel"></div>
    <div class="modal-box">
        <h3>@(_isNew ? "ثبت رکورد جدید" : "ویرایش رکورد") — @Title</h3>
        <div class="form-grid">
            @foreach (var p in EditableProps)
            {
                <div class="form-field">
                    <label>@Label(p)</label>
                    @RenderInput(p)
                </div>
            }
            <div class="form-field">
                <label>وضعیت</label>
                <label class="switch">
                    <input type="checkbox" checked="@_editing.IsActive"
                           @onchange="e => _editing.IsActive = (bool)(e.Value ?? false)" />
                    <span>فعال باشد</span>
                </label>
            </div>
        </div>
        <div style="display:flex;gap:.6rem;justify-content:flex-start;margin-top:1.2rem;">
            <button class="btn-solon" @onclick="async () => await Save()">ذخیره</button>
            <button class="btn-solon ghost" @onclick="Cancel">انصراف</button>
        </div>
    </div>
}

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string ImageSection { get; set; } = "portfolio";

    private string _search = "";
    private string? _message;
    private TEntity? _editing;
    private bool _isNew;

    // شناسه‌ها و کدهای سیستمی که هرگز نباید به عنوان ورودی خام دستی به کاربر نشان داده شوند
    private static readonly string[] HiddenFromEdit = {
        "ID", "Tc", "IsActive", "IsDelete", "RegisterData",
        "TrackingCode", "SalonTC", "TC_Salon", "salon_Tc"
    };

    private static List<PropertyInfo> AllProps => typeof(TEntity)
        .GetProperties(BindingFlags.Public | BindingFlags.Instance)
        .Where(p => p.CanWrite && !HiddenFromEdit.Contains(p.Name))
        .ToList();

    private List<PropertyInfo> EditableProps => AllProps;
    private List<PropertyInfo> Columns => AllProps.Take(5).ToList();

    private static readonly string[] ImageKeywords = { "pic", "image", "logo", "photo", "sample", "avatar" };

    private static bool IsImageField(string name)
        => ImageKeywords.Any(k => name.Contains(k, StringComparison.OrdinalIgnoreCase));

    private static string Label(PropertyInfo p)
    {
        var raw = p.GetCustomAttribute<DisplayAttribute>()?.Name ?? p.Name;
        // پالایش کامل نام‌ها جهت عدم نمایش کلمات فنی TC به کاربر
        return raw.Replace("(TC)", "")
                  .Replace("TC", "")
                  .Replace("کد پیگیری سیستمی", "کد پیگیری")
                  .Trim();
    }

    // نگاشت شناسه‌ها به عناوین ملموس (نام سالن، نام خدمت، دسته‌بندی و...)
    private Guid _currentSalonTc = Guid.Parse("11111111-1111-1111-1111-111111111111");
    private string _currentSalonName = "سالن تخصصی زیبایی حدیث";
    private Dictionary<Guid, string> _nameLookup = new();
    private List<(Guid Id, string Name)> _categories = new();
    private List<(Guid Id, string Name)> _services = new();
    private List<(Guid Id, string Name)> _personnel = new();
    private List<(Guid Id, string Name)> _customers = new();
    private List<(Guid Id, string Name)> _roles = new();
    private List<(Guid Id, string Name)> _permissions = new();
    private List<(Guid Id, string Name)> _sampleCategories = new();

    private string DisplayValue(PropertyInfo p, object? value)
    {
        if (value is null) return "-";
        if (value is bool b) return b ? "بله" : "خیر";
        if (value is DateTime dt) return PersianDateHelper.ToShamsi(dt, false);
        if (value is decimal m) return m.ToString("#,0") + " تومان";
        if (value is Guid g)
        {
            if (g == Guid.Empty) return "-";
            if (g == _currentSalonTc) return _currentSalonName;
            if (_nameLookup.TryGetValue(g, out var name)) return name;
            return "انتخاب شده";
        }
        return value.ToString() ?? "-";
    }

    private List<TEntity> _items = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadLookupsAsync();
        await LoadAsync();
    }

    private async Task LoadLookupsAsync()
    {
        try
        {
            var salonSettings = await Store.AllAsync<Tbl_SalonSetting>();
            var sSetting = salonSettings.FirstOrDefault();
            if (sSetting is not null)
            {
                _currentSalonTc = sSetting.Tc;
                _currentSalonName = sSetting.SalonName;
                _nameLookup[sSetting.Tc] = sSetting.SalonName;
            }

            var cats = await Store.AllAsync<Tbl_Category>();
            _categories = cats.Select(c => (c.Tc, c.CategoryName)).ToList();
            foreach (var c in cats) _nameLookup[c.Tc] = c.CategoryName;

            var services = await Store.AllAsync<Tbl_SalonSerice>();
            _services = services.Select(s => (s.Tc, s.ServiceName)).ToList();
            foreach (var s in services) _nameLookup[s.Tc] = s.ServiceName;

            var staff = await Store.AllAsync<Tbl_Personal>();
            _personnel = staff.Select(st => (st.Tc, st.FullName)).ToList();
            foreach (var st in staff) _nameLookup[st.Tc] = st.FullName;

            var customers = await Store.AllAsync<Tbl_Customer>();
            _customers = customers.Select(cu => (cu.Tc, cu.FullName)).ToList();
            foreach (var cu in customers) _nameLookup[cu.Tc] = cu.FullName;

            var roles = await Store.AllAsync<Tbl_Roles>();
            _roles = roles.Select(r => (r.Tc, r.RoleName)).ToList();
            foreach (var r in roles) _nameLookup[r.Tc] = r.RoleName;

            var perms = await Store.AllAsync<Tbl_Permission>();
            _permissions = perms.Select(pe => (pe.Tc, pe.PermissionName)).ToList();
            foreach (var pe in perms) _nameLookup[pe.Tc] = pe.PermissionName;

            var sampleCats = await Store.AllAsync<Tbl_CategoryPortfolio>();
            _sampleCategories = sampleCats.Select(sc => (sc.Tc, sc.CategoryNameSample)).ToList();
            foreach (var sc in sampleCats) _nameLookup[sc.Tc] = sc.CategoryNameSample;
        }
        catch { }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _items = await Store.AllAsync<TEntity>();
        _loading = false;
    }

    private List<TEntity> Filtered()
    {
        var list = _items;
        if (string.IsNullOrWhiteSpace(_search)) return list;
        return list.Where(x => AllProps.Any(p =>
            (p.GetValue(x)?.ToString() ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase))).ToList();
    }

    private void StartCreate()
    {
        _editing = (TEntity)Activator.CreateInstance(typeof(TEntity))!;
        _editing.Tc = Guid.NewGuid();
        _editing.IsActive = true;
        _editing.RegisterData = DateTime.Now;

        // انتساب خودکار شناسه سالن بدون دخالت و نمایش کدهای سیستمی به کاربر
        SetEntityPropertyIfExists(_editing, "SalonTC", _currentSalonTc);
        SetEntityPropertyIfExists(_editing, "TC_Salon", _currentSalonTc);
        SetEntityPropertyIfExists(_editing, "salon_Tc", _currentSalonTc);

        // تولید خودکار کد پیگیری نوبت
        var tcProp = typeof(TEntity).GetProperty("TrackingCode");
        if (tcProp != null && tcProp.CanWrite)
        {
            tcProp.SetValue(_editing, $"HB-{DateTime.Now:yyMMdd}-{Random.Shared.Next(1000, 9999)}");
        }

        // مقداردهی پیش‌فرض کلیدهای خارجی با اولین مورد موجود در صورت نیاز
        if (_categories.Any()) SetEntityPropertyIfGuidEmpty(_editing, "CategoryTC", _categories[0].Id);
        if (_services.Any()) SetEntityPropertyIfGuidEmpty(_editing, "ServiceTC", _services[0].Id);
        if (_services.Any()) SetEntityPropertyIfGuidEmpty(_editing, "TC_Service", _services[0].Id);
        if (_personnel.Any()) SetEntityPropertyIfGuidEmpty(_editing, "PersonalTC", _personnel[0].Id);
        if (_personnel.Any()) SetEntityPropertyIfGuidEmpty(_editing, "TC_Personal", _personnel[0].Id);
        if (_sampleCategories.Any()) SetEntityPropertyIfGuidEmpty(_editing, "SampleTC", _sampleCategories[0].Id);
        if (_roles.Any()) SetEntityPropertyIfGuidEmpty(_editing, "RoleTC", _roles[0].Id);
        if (_permissions.Any()) SetEntityPropertyIfGuidEmpty(_editing, "PermissionTC", _permissions[0].Id);

        _isNew = true;
        _message = null;
    }

    private static void SetEntityPropertyIfExists(object entity, string propName, Guid val)
    {
        var prop = entity.GetType().GetProperty(propName);
        if (prop != null && prop.CanWrite && prop.PropertyType == typeof(Guid))
        {
            prop.SetValue(entity, val);
        }
    }

    private static void SetEntityPropertyIfGuidEmpty(object entity, string propName, Guid val)
    {
        var prop = entity.GetType().GetProperty(propName);
        if (prop != null && prop.CanWrite && prop.PropertyType == typeof(Guid))
        {
            var cur = (Guid)(prop.GetValue(entity) ?? Guid.Empty);
            if (cur == Guid.Empty)
            {
                prop.SetValue(entity, val);
            }
        }
    }

    private void StartEdit(TEntity item)
    {
        var clone = (TEntity)Activator.CreateInstance(typeof(TEntity))!;
        foreach (var p in typeof(TEntity).GetProperties().Where(p => p.CanWrite))
            p.SetValue(clone, p.GetValue(item));
        _editing = clone;
        _isNew = false;
        _message = null;
    }

    private async Task Save()
    {
        if (_editing is null) return;

        // اطمینان از مقداردهی سالن جاری
        SetEntityPropertyIfExists(_editing, "SalonTC", _currentSalonTc);
        SetEntityPropertyIfExists(_editing, "TC_Salon", _currentSalonTc);
        SetEntityPropertyIfExists(_editing, "salon_Tc", _currentSalonTc);

        var ok = _isNew ? await Store.AddAsync(_editing) : await Store.UpdateAsync(_editing);
        _message = ok
            ? (_isNew ? "رکورد جدید با موفقیت ثبت شد" : "تغییرات ذخیره شد")
            : "ذخیره سازی ناموفق بود";
        _editing = null;
        await LoadAsync();
    }

    private async Task Remove(TEntity item)
    {
        await Store.DeleteAsync<TEntity>(item.Tc);
        _message = "رکورد حذف شد";
        await LoadAsync();
    }

    private void Cancel() { _editing = null; }

    private RenderFragment RenderInput(PropertyInfo p) => builder =>
    {
        var type = Nullable.GetUnderlyingType(p.PropertyType) ?? p.PropertyType;
        var value = p.GetValue(_editing);
        var propName = p.Name;

        // ۱. فیلدهای انتخابی خدمت (کاربر فقط نام خدمت را می‌بیند و انتخاب می‌کند)
        if (propName.Equals("ServiceTC", StringComparison.OrdinalIgnoreCase) ||
            propName.Equals("TC_Service", StringComparison.OrdinalIgnoreCase))
        {
            RenderDropdown(builder, p, _services, "انتخاب خدمت...");
            return;
        }

        // ۲. فیلدهای انتخابی دسته‌بندی
        if (propName.Equals("CategoryTC", StringComparison.OrdinalIgnoreCase))
        {
            RenderDropdown(builder, p, _categories, "انتخاب دسته‌بندی...");
            return;
        }

        // ۳. فیلدهای انتخابی پرسنل / متخصص
        if (propName.Equals("PersonalTC", StringComparison.OrdinalIgnoreCase) ||
            propName.Equals("TC_Personal", StringComparison.OrdinalIgnoreCase))
        {
            RenderDropdown(builder, p, _personnel, "انتخاب متخصص...");
            return;
        }

        // ۴. فیلدهای انتخابی نمونه‌کار
        if (propName.Equals("SampleTC", StringComparison.OrdinalIgnoreCase))
        {
            RenderDropdown(builder, p, _sampleCategories, "انتخاب دسته‌بندی نمونه‌کار...");
            return;
        }

        // ۵. فیلدهای انتخابی نقش
        if (propName.Equals("RoleTC", StringComparison.OrdinalIgnoreCase))
        {
            RenderDropdown(builder, p, _roles, "انتخاب نقش...");
            return;
        }

        // ۶. فیلدهای انتخابی دسترسی
        if (propName.Equals("PermissionTC", StringComparison.OrdinalIgnoreCase))
        {
            RenderDropdown(builder, p, _permissions, "انتخاب دسترسی...");
            return;
        }

        // ۷. فیلدهای انتخابی مشتری
        if (propName.Equals("CustomerTC", StringComparison.OrdinalIgnoreCase))
        {
            RenderDropdown(builder, p, _customers, "انتخاب مشتری...");
            return;
        }

        // ۸. فیلدهای تصویر
        if (type == typeof(string) && IsImageField(p.Name))
        {
            builder.OpenComponent<BlazorAppSolon.Components.Panel.ImageUpload>(0);
            builder.AddAttribute(1, "Value", (string?)value);
            builder.AddAttribute(2, "Section", ImageSection);
            builder.AddAttribute(3, "ValueChanged",
                EventCallback.Factory.Create<string?>(this, v => p.SetValue(_editing, v)));
            builder.CloseComponent();
            return;
        }

        // ۹. فیلدهای بولی
        if (type == typeof(bool))
        {
            builder.OpenElement(0, "input");
            builder.AddAttribute(1, "type", "checkbox");
            builder.AddAttribute(2, "checked", (bool?)value ?? false);
            builder.AddAttribute(3, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this,
                e => p.SetValue(_editing, (bool)(e.Value ?? false))));
            builder.CloseElement();
            return;
        }

        // ۱۰. فیلدهای تاریخ — استفاده انحصاری از دیت‌پیکر شمسی (PersianDatePicker)
        if (type == typeof(DateTime))
        {
            var dt = (DateTime)(value ?? DateTime.Today);
            builder.OpenComponent<BlazorAppSolon.Components.PersianDatePicker>(0);
            builder.AddAttribute(1, "Value", dt);
            builder.AddAttribute(2, "DisablePast", false);
            builder.AddAttribute(3, "ValueChanged", EventCallback.Factory.Create<DateTime>(this, d => p.SetValue(_editing, d)));
            builder.CloseComponent();
            return;
        }

        // ۱۱. سایر فیلدهای استاندارد
        var inputType = (type == typeof(int) || type == typeof(decimal) || type == typeof(double)) ? "number"
            : type == typeof(TimeSpan) ? "time"
            : "text";

        var text = value switch
        {
            TimeSpan t => t.ToString(@"hh\:mm"),
            null => "",
            _ => value.ToString() ?? ""
        };

        builder.OpenElement(0, "input");
        builder.AddAttribute(1, "class", "panel-input");
        builder.AddAttribute(2, "type", inputType);
        builder.AddAttribute(3, "value", text);
        builder.AddAttribute(4, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this,
            e => SetValue(p, type, e.Value?.ToString())));
        builder.CloseElement();
    };

    private void RenderDropdown(
        Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder,
        PropertyInfo p,
        List<(Guid Id, string Name)> items,
        string placeholder)
    {
        var curVal = (Guid?)(p.GetValue(_editing)) ?? Guid.Empty;

        builder.OpenElement(0, "select");
        builder.AddAttribute(1, "class", "panel-input");
        builder.AddAttribute(2, "value", curVal.ToString());
        builder.AddAttribute(3, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e =>
        {
            if (Guid.TryParse(e.Value?.ToString(), out var parsed))
            {
                p.SetValue(_editing, parsed);
            }
        }));

        if (!items.Any(i => i.Id == curVal))
        {
            builder.OpenElement(4, "option");
            builder.AddAttribute(5, "value", Guid.Empty.ToString());
            builder.AddContent(6, placeholder);
            builder.CloseElement();
        }

        int seq = 7;
        foreach (var item in items)
        {
            builder.OpenElement(seq++, "option");
            builder.AddAttribute(seq++, "value", item.Id.ToString());
            builder.AddAttribute(seq++, "selected", item.Id == curVal);
            builder.AddContent(seq++, item.Name);
            builder.CloseElement();
        }

        builder.CloseElement();
    }

    private void SetValue(PropertyInfo p, Type type, string? raw)
    {
        try
        {
            object? converted =
                string.IsNullOrWhiteSpace(raw) && Nullable.GetUnderlyingType(p.PropertyType) is not null ? null
                : type == typeof(string) ? raw ?? ""
                : type == typeof(int) ? int.Parse(raw!)
                : type == typeof(decimal) ? decimal.Parse(raw!)
                : type == typeof(double) ? double.Parse(raw!)
                : type == typeof(Guid) ? (string.IsNullOrWhiteSpace(raw) ? Guid.Empty : Guid.Parse(raw))
                : type == typeof(DateTime) ? DateTime.Parse(raw!)
                : type == typeof(TimeSpan) ? TimeSpan.Parse(raw!)
                : raw;

            p.SetValue(_editing, converted);
            _message = null;
        }
        catch
        {
            _message = $"مقدار وارد شده برای «{Label(p)}» معتبر نیست";
        }
    }
}
