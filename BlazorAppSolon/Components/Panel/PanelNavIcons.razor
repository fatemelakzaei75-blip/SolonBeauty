@* ==========================================================================
   آیکون‌های خطی منوی پنل — جایگزین ایموجی‌ها
   --------------------------------------------------------------------------
   چرا SVG و نه ایموجی: ایموجی در iOS، اندروید و ویندوز شکل و وزن خطی
   کاملاً متفاوتی دارد و رنگ آن با currentColor هم‌رنگ نمی‌شود؛ در یک
   Web Application تجاری با هویت طلایی مشخص، این ناهمگونی برند را می‌شکند.
   همه آیکون‌ها یک شبکه‌ی ۲۴×۲۴ و ضخامت خط ۱.۷ دارند تا کنار هم یکدست بمانند.
   ========================================================================== *@

<svg class="pnav-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="true" focusable="false">
    @switch (Name)
    {
        @* داشبورد — نمودار ستونی *@
        case "dashboard":
            <path d="M4 20V10M10 20V4M16 20v-7M22 20H2" />
            break;

        @* اطلاعات پایه — لایه‌های روی هم *@
        case "layers":
            <path d="M12 3 2.5 8 12 13l9.5-5L12 3Z" />
            <path d="M2.5 13 12 18l9.5-5" />
            <path d="M2.5 17.5 12 22.5l9.5-5" />
            break;

        @* نوبت‌ها — تقویم *@
        case "calendar":
            <rect x="3" y="5" width="18" height="16" rx="3" />
            <path d="M3 10h18M8 3v4M16 3v4" />
            <circle cx="8.5" cy="14.5" r="1" fill="currentColor" stroke="none" />
            <circle cx="12.5" cy="14.5" r="1" fill="currentColor" stroke="none" />
            break;

        @* لیست انتظار — ساعت شنی *@
        case "hourglass":
            <path d="M7 3h10M7 21h10" />
            <path d="M8 3v4.2c0 2.2 4 3.9 4 4.8 0 .9-4 2.6-4 4.8V21" />
            <path d="M16 3v4.2c0 2.2-4 3.9-4 4.8 0 .9 4 2.6 4 4.8V21" />
            break;

        @* مشتریان — گروه افراد *@
        case "users":
            <circle cx="9" cy="8" r="3.4" />
            <path d="M2.8 20c.5-3.6 3.2-6 6.2-6s5.7 2.4 6.2 6" />
            <path d="M16.5 5.2a3.4 3.4 0 0 1 0 6.6" />
            <path d="M18 20h3.2c-.3-2.4-1.5-4.3-3.3-5.3" />
            break;

        @* پرسنل — کاربر با تیک تأیید *@
        case "userCheck":
            <circle cx="10" cy="7.5" r="3.6" />
            <path d="M3.5 20c.5-4 3.3-6.6 6.5-6.6 1.6 0 3.1.6 4.3 1.7" />
            <path d="M15.2 18.4l2.2 2.2 4.4-4.6" />
            break;

        @* خدمات — درخشش *@
        case "sparkles":
            <path d="M12 3.5c.9 3.6 1.9 4.6 5.5 5.5-3.6.9-4.6 1.9-5.5 5.5-.9-3.6-1.9-4.6-5.5-5.5 3.6-.9 4.6-1.9 5.5-5.5Z" />
            <path d="M18.5 15c.45 1.8.95 2.3 2.75 2.75-1.8.45-2.3.95-2.75 2.75-.45-1.8-.95-2.3-2.75-2.75 1.8-.45 2.3-.95 2.75-2.75Z" />
            <path d="M6 16.5c.3 1.2.65 1.55 1.85 1.85-1.2.3-1.55.65-1.85 1.85-.3-1.2-.65-1.55-1.85-1.85 1.2-.3 1.55-.65 1.85-1.85Z" />
            break;

        @* گالری — تصویر *@
        case "image":
            <rect x="3" y="4" width="18" height="16" rx="3" />
            <circle cx="8.6" cy="9.6" r="1.7" />
            <path d="m4 17.5 4.6-4.6c.7-.7 1.8-.7 2.5 0l3 3c.7.7 1.8.7 2.5 0L20 12.5" />
            break;

        @* تنظیمات — چرخ‌دنده *@
        case "settings":
            <circle cx="12" cy="12" r="3.2" />
            <path d="M19.6 14.4a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.7 1.7 0 0 0-1.87-.34 1.7 1.7 0 0 0-1.03 1.56V22a2 2 0 1 1-4 0v-.11a1.7 1.7 0 0 0-1.11-1.56 1.7 1.7 0 0 0-1.87.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.7 1.7 0 0 0 .34-1.87 1.7 1.7 0 0 0-1.56-1.03H8a2 2 0 1 1 0-4h.11A1.7 1.7 0 0 0 9.67 9.8a1.7 1.7 0 0 0-.34-1.87l-.06-.06A2 2 0 1 1 12.1 5.04l.06.06a1.7 1.7 0 0 0 1.87.34H14a1.7 1.7 0 0 0 1.03-1.56V3.77a2 2 0 1 1 4 0v.11a1.7 1.7 0 0 0 1.03 1.56 1.7 1.7 0 0 0 1.87-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.7 1.7 0 0 0-.34 1.87V10a1.7 1.7 0 0 0 1.56 1.03h.11a2 2 0 1 1 0 4h-.11a1.7 1.7 0 0 0-1.42 1.03Z"
                  transform="translate(-3.2 -1.8) scale(0.92)" />
            break;

        @* کد تخفیف — برچسب *@
        case "tag":
            <path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.83 0l-7.2-7.2A2 2 0 0 1 2.8 12V4.8A2 2 0 0 1 4.8 2.8H12a2 2 0 0 1 1.41.58l7.2 7.2a2 2 0 0 1 0 2.83Z" />
            <circle cx="7.9" cy="7.9" r="1.4" />
            break;

        @* اخبار — بلندگو *@
        case "megaphone":
            <path d="M3.5 10.2v3.6a1.8 1.8 0 0 0 1.8 1.8h1.4l7.6 4.2V4.2L6.7 8.4H5.3a1.8 1.8 0 0 0-1.8 1.8Z" />
            <path d="M18 8.4a5 5 0 0 1 0 7.2" />
            <path d="M7.5 15.6V19a1.6 1.6 0 0 0 3.2 0v-1.6" />
            break;

        @* اعلانات — زنگ *@
        case "bell":
            <path d="M18 8.4a6 6 0 1 0-12 0c0 5.2-2 6.6-2 6.6h16s-2-1.4-2-6.6Z" />
            <path d="M13.7 19a2 2 0 0 1-3.4 0" />
            break;

        @* پروفایل — کاربر *@
        case "user":
            <circle cx="12" cy="7.8" r="3.8" />
            <path d="M4.6 20.2c.6-4.2 3.6-7 7.4-7s6.8 2.8 7.4 7" />
            break;

        @* علاقه‌مندی‌ها — قلب *@
        case "heart":
            <path d="M12 20.3S3.6 15.4 3.6 9.6a4.6 4.6 0 0 1 8.4-2.7 4.6 4.6 0 0 1 8.4 2.7c0 5.8-8.4 10.7-8.4 10.7Z" />
            break;

        @* خروج از حساب *@
        case "logout":
            <path d="M9.5 21H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.5" />
            <path d="m15 16.5 4.5-4.5L15 7.5" />
            <path d="M19.5 12H9" />
            break;

        @* فلش جمع‌کردن (جهت با CSS معکوس می‌شود) *@
        case "chevron":
            <path d="m14.5 6-6 6 6 6" />
            break;

        @* فلش کوچک سرگروه آکاردئون *@
        case "caret":
            <path d="m6 9.5 6 6 6-6" />
            break;

        default:
            <circle cx="12" cy="12" r="8" />
            break;
    }
</svg>

@code {
    /// <summary>کلید آیکون — با کلیدهای موجود در PanelNavConfig یکسان است</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "default";
}
